---
import BaseLayout from '../../layouts/BaseLayout.astro';
import tips from '../../data/tips.json';
import products from '../../data/products.json';

export function getStaticPaths() {
  return tips.map((tip) => ({
    params: { slug: tip.slug },
    props: { tip },
  }));
}

const { tip } = Astro.props;
const product = products.find((p) => p.id === tip.productId)!;
const relatedTips = tips.filter((t) => t.productId === tip.productId && t.id !== tip.id).slice(0, 2);
---

<BaseLayout
  title={`${tip.title} | ${product.name} 實用教學 — Kairos Vector Studio`}
  description={tip.summary}
  ogTitle={tip.title}
  ogDescription={tip.summary}
>
  <article class="article-page">
    <div class="hero__bg"></div>
    <div class="hero__grid-pattern"></div>

    <div class="container container--narrow">
      <!-- Breadcrumbs -->
      <nav class="breadcrumb" aria-label="文章導覽路徑">
        <a href="/">首頁</a>
        <span class="breadcrumb__separator">/</span>
        <a href={`/${product.id}`}>{product.name}</a>
        <span class="breadcrumb__separator">/</span>
        <a href={`/${product.id}#tips`}>實用技巧專欄</a>
        <span class="breadcrumb__separator">/</span>
        <span class="breadcrumb__current">{tip.category}</span>
      </nav>

      <!-- Article Header -->
      <header class="article-header">
        <div class="article-header__meta">
          <span class={`badge badge--${product.id}`}>{tip.category}</span>
          <span class="article-header__readtime">⏱️ {tip.readTime}</span>
        </div>
        <h1 class="article-header__title">{tip.title}</h1>
        <p class="article-header__lead">{tip.summary}</p>
      </header>

      <!-- Article Body -->
      <div class="article-body card">
        {tip.content.map((block) => (
          <Fragment>
            {block.type === 'heading' && <h2 class="article-body__heading">{block.text}</h2>}
            {block.type === 'paragraph' && <p class="article-body__paragraph" set:html={block.text}></p>}
            {block.type === 'callout' && (
              <div class="article-callout" style={`border-left-color: ${product.accentColor}`}>
                <div class="article-callout__title">{block.title}</div>
                <div class="article-callout__text" set:html={block.text}></div>
              </div>
            )}
            {block.type === 'promo' && (
              <div class="article-promo-card">
                <div class="article-promo-card__icon">{block.icon || '🌟'}</div>
                <div class="article-promo-card__content">
                  <div class="article-promo-card__title">{block.title}</div>
                  <div class="article-promo-card__desc">{block.desc}</div>
                </div>
                <a href={block.href} class="btn btn--vibrant btn--sm article-promo-card__btn">{block.btnText || '探索專欄 →'}</a>
              </div>
            )}
            {block.type === 'steps' && (
              <ol class="article-steps">
                {block.items?.map((stepItem: string, idx: number) => (
                  <li class="article-step-item">
                    <span class="article-step-item__num" style={`background: ${product.accentColor};`}>{idx + 1}</span>
                    <div class="article-step-item__text">{stepItem}</div>
                  </li>
                ))}
              </ol>
            )}
            {block.type === 'table' && (
              <div class="article-table-wrapper">
                <table class="article-table">
                  {block.headers && (
                    <thead>
                      <tr>
                        {block.headers.map((h: string) => <th>{h}</th>)}
                      </tr>
                    </thead>
                  )}
                  <tbody>
                    {block.rows?.map((row: string[]) => (
                      <tr>
                        {row.map((cell: string, cIdx: number) => (
                          <td class={cIdx === (block.highlightCol ?? -1) ? 'cell--highlight' : ''}>{cell}</td>
                        ))}
                      </tr>
                    ))}
                  </tbody>
                </table>
              </div>
            )}
            {block.type === 'image' && (
              <figure class={`article-figure ${block.size === 'full' ? 'article-figure--full' : ''}`}>
                <img src={block.src} alt={block.caption || ''} loading="lazy" class="article-figure__img" />
                {block.caption && <figcaption class="article-figure__caption">{block.caption}</figcaption>}
              </figure>
            )}
          </Fragment>
        ))}

        <!-- Studio Author Stamp -->
        <div class="article-author-card">
          <div class="article-author-card__avatar">K</div>
          <div>
            <div class="article-author-card__name">Kairos Vector Studio 編輯團隊</div>
            <div class="article-author-card__desc">專注於 Android 實用測試工具與玩家助手開發。</div>
          </div>
        </div>
      </div>

      <!-- In-Article App Download CTA Box -->
      <div class="article-download-box" data-animate>
        <div class="article-download-box__left">
          <div class="article-download-box__title">立即體驗 {product.name}</div>
          <div class="article-download-box__desc">{product.shortDescription}</div>
        </div>
        <div class="article-download-box__right">
          <a href={product.playStoreUrl} target="_blank" rel="noopener" class="btn btn--vibrant btn--lg">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="currentColor">
              <path d="M3.609 1.814L13.792 12 3.61 22.186a.996.996 0 01-.61-.92V2.734a1 1 0 01.609-.92zm10.89 10.893l2.302 2.302-10.937 6.333 8.635-8.635zm3.199-3.199l2.302 1.329-2.822 1.634-2.116-2.116 2.636-2.847zm-4.529-4.528L4.864 1.367 15.8 7.7l-2.63 2.88z"/>
            </svg>
            前往 Google Play 下載
          </a>
        </div>
      </div>

      <!-- Related Tips / Back Link -->
      {relatedTips.length > 0 && (
        <section class="related-tips-section">
          <div class="related-tips-section__header">
            <h3>更多 {product.name} 技巧文章</h3>
            <a href={`/${product.id}#tips`} class="related-tips-section__link">查看所有技巧 →</a>
          </div>
          <div class="related-tips-grid">
            {relatedTips.map((rTip) => (
              <a href={`/tips/${rTip.slug}`} class="card related-tip-card">
                <span class={`badge badge--${product.id}`}>{rTip.category}</span>
                <h4 class="related-tip-card__title">{rTip.title}</h4>
                <p class="related-tip-card__desc">{rTip.summary}</p>
                <span class="related-tip-card__more">閱讀全文 →</span>
              </a>
            ))}
          </div>
        </section>
      )}

      <div style="text-align: center; margin: var(--space-12) 0 var(--space-8);">
        <a href={`/${product.id}`} class="btn btn--outline">
          ← 返回 {product.name} 產品專頁
        </a>
      </div>

    </div>
  </article>
</BaseLayout>

<style>
  .article-page {
    padding-top: calc(var(--nav-height) + var(--space-12));
    padding-bottom: var(--space-20);
    position: relative;
  }

  .breadcrumb {
    display: flex;
    align-items: center;
    gap: var(--space-2);
    font-size: var(--text-xs);
    color: var(--color-text-muted);
    margin-bottom: var(--space-8);
    flex-wrap: wrap;
  }

  .breadcrumb a {
    color: var(--color-text-secondary);
    transition: color var(--duration-fast) var(--ease-out);
  }

  .breadcrumb a:hover {
    color: var(--color-brand-light);
  }

  .breadcrumb__separator {
    color: var(--color-border);
  }

  .breadcrumb__current {
    color: var(--color-text);
    font-weight: 600;
  }

  .article-header {
    margin-bottom: var(--space-10);
  }

  .article-header__meta {
    display: flex;
    align-items: center;
    gap: var(--space-3);
    margin-bottom: var(--space-4);
  }

  .article-header__readtime {
    font-size: var(--text-xs);
    color: var(--color-text-secondary);
    font-weight: 500;
  }

  .article-header__title {
    font-size: var(--text-4xl);
    line-height: 1.25;
    margin-bottom: var(--space-4);
  }

  .article-header__lead {
    font-size: var(--text-lg);
    color: var(--color-text-secondary);
    line-height: 1.7;
  }

  .article-body {
    padding: var(--space-10);
    margin-bottom: var(--space-10);
  }

  .article-body__heading {
    font-size: var(--text-2xl);
    font-weight: 700;
    margin: var(--space-8) 0 var(--space-4);
    color: var(--color-text);
  }

  .article-body__heading:first-child {
    margin-top: 0;
  }

  .article-body__paragraph {
    font-size: var(--text-base);
    line-height: 1.8;
    color: var(--color-text-secondary);
    margin-bottom: var(--space-6);
  }

  .article-body__paragraph a,
  .article-callout__text a {
    color: var(--color-geosim);
    text-decoration: underline;
    font-weight: 600;
    transition: color var(--duration-fast) var(--ease-out);
  }

  .article-body__paragraph a:hover,
  .article-callout__text a:hover {
    color: var(--color-brand-light);
  }

  .article-promo-card {
    display: flex;
    align-items: center;
    gap: var(--space-5);
    background: linear-gradient(135deg, rgba(2, 132, 199, 0.12) 0%, rgba(14, 165, 233, 0.05) 100%);
    border: 1.5px solid rgba(2, 132, 199, 0.35);
    border-radius: var(--radius-lg);
    padding: var(--space-5) var(--space-6);
    margin: var(--space-8) 0;
    box-shadow: 0 4px 20px rgba(2, 132, 199, 0.08);
  }

  @media (max-width: 640px) {
    .article-promo-card {
      flex-direction: column;
      align-items: flex-start;
      gap: var(--space-4);
    }
  }

  .article-promo-card__icon {
    font-size: 32px;
    flex-shrink: 0;
  }

  .article-promo-card__content {
    flex: 1;
  }

  .article-promo-card__title {
    font-family: var(--font-display);
    font-weight: 700;
    font-size: var(--text-base);
    color: var(--color-text);
    margin-bottom: 4px;
  }

  .article-promo-card__desc {
    font-size: var(--text-xs);
    color: var(--color-text-secondary);
    line-height: 1.6;
  }

  .article-promo-card__btn {
    flex-shrink: 0;
    white-space: nowrap;
  }

  .article-callout {
    background: var(--color-bg-subtle);
    border-left: 4px solid var(--color-brand);
    border-radius: 0 var(--radius-md) var(--radius-md) 0;
    padding: var(--space-5) var(--space-6);
    margin: var(--space-6) 0;
  }

  .article-callout__title {
    font-family: var(--font-display);
    font-weight: 700;
    font-size: var(--text-base);
    color: var(--color-text);
    margin-bottom: var(--space-2);
  }

  .article-callout__text {
    font-size: var(--text-sm);
    color: var(--color-text-secondary);
    line-height: 1.7;
    white-space: pre-line;
  }

  .article-steps {
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: var(--space-4);
    margin: var(--space-6) 0;
  }

  .article-step-item {
    display: flex;
    align-items: flex-start;
    gap: var(--space-4);
    background: var(--color-bg-subtle);
    padding: var(--space-4) var(--space-5);
    border-radius: var(--radius-md);
    border: 1px solid var(--color-border-subtle);
  }

  .article-step-item__num {
    flex-shrink: 0;
    width: 26px;
    height: 26px;
    border-radius: 50%;
    color: white;
    font-family: var(--font-display);
    font-weight: 800;
    font-size: var(--text-xs);
    display: flex;
    align-items: center;
    justify-content: center;
    margin-top: 2px;
  }

  .article-step-item__text {
    font-size: var(--text-base);
    color: var(--color-text);
    line-height: 1.7;
  }

  .article-figure {
    margin: var(--space-6) auto;
    max-width: 240px;
    background: var(--color-bg-subtle);
    border: 1px solid var(--color-border);
    border-radius: 18px;
    overflow: hidden;
    box-shadow: 0 4px 20px rgba(0, 0, 0, 0.2);
  }

  .article-figure--full {
    max-width: 640px;
    border-radius: var(--radius-lg);
  }

  .article-figure--full .article-figure__img {
    max-height: none;
  }

  .article-figure__img {
    width: 100%;
    max-height: 480px;
    height: auto;
    display: block;
    object-fit: contain;
    border-bottom: 1px solid var(--color-border-subtle);
  }

  .article-figure__caption {
    font-size: var(--text-xs);
    color: var(--color-text-muted);
    padding: var(--space-3) var(--space-4);
    line-height: 1.5;
    background: var(--color-surface);
  }

  .article-table-wrapper {
    overflow-x: auto;
    margin: var(--space-6) 0;
    border-radius: var(--radius-md);
    border: 1px solid var(--color-border-subtle);
    background: var(--color-bg-subtle);
    -webkit-overflow-scrolling: touch;
  }

  .article-table {
    width: 100%;
    border-collapse: collapse;
    font-size: var(--text-sm);
    text-align: left;
  }

  .article-table th {
    background: rgba(255, 255, 255, 0.05);
    padding: var(--space-3) var(--space-4);
    font-weight: 700;
    color: var(--color-text);
    border-bottom: 1px solid var(--color-border);
    white-space: nowrap;
  }

  .article-table td {
    padding: var(--space-3) var(--space-4);
    color: var(--color-text-secondary);
    border-bottom: 1px solid var(--color-border-subtle);
    white-space: nowrap;
  }

  .article-table tr:last-child td {
    border-bottom: none;
  }

  .article-table tr:hover td {
    background: rgba(255, 255, 255, 0.02);
  }

  .article-table td.cell--highlight {
    color: #38bdf8;
    font-weight: 700;
  }

  .article-author-card {
    display: flex;
    align-items: center;
    gap: var(--space-4);
    margin-top: var(--space-10);
    padding-top: var(--space-6);
    border-top: 1px solid var(--color-border-subtle);
  }

  .article-author-card__avatar {
    width: 44px;
    height: 44px;
    border-radius: 50%;
    background: var(--btn-gradient);
    color: white;
    font-family: var(--font-display);
    font-weight: 800;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 18px;
  }

  .article-author-card__name {
    font-weight: 700;
    font-size: var(--text-sm);
    color: var(--color-text);
  }

  .article-author-card__desc {
    font-size: var(--text-xs);
    color: var(--color-text-secondary);
    margin-top: 2px;
  }

  .article-download-box {
    display: flex;
    align-items: center;
    justify-content: space-between;
    background: linear-gradient(135deg, var(--color-surface) 0%, var(--color-bg-subtle) 100%);
    border: 1px solid var(--color-brand);
    border-radius: var(--radius-xl);
    padding: var(--space-8);
    gap: var(--space-6);
    margin-bottom: var(--space-12);
    box-shadow: var(--shadow-md);
  }

  .article-download-box__title {
    font-family: var(--font-display);
    font-size: var(--text-xl);
    font-weight: 700;
    color: var(--color-text);
    margin-bottom: var(--space-1);
  }

  .article-download-box__desc {
    font-size: var(--text-sm);
    color: var(--color-text-secondary);
    max-width: 40ch;
  }

  .related-tips-section {
    margin-top: var(--space-12);
  }

  .related-tips-section__header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin-bottom: var(--space-6);
  }

  .related-tips-section__header h3 {
    font-size: var(--text-xl);
    font-weight: 700;
  }

  .related-tips-section__link {
    font-size: var(--text-sm);
    font-weight: 600;
    color: var(--color-brand-light);
  }

  .related-tips-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: var(--space-6);
  }

  .related-tip-card {
    text-decoration: none;
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    padding: var(--space-6);
  }

  .related-tip-card__title {
    font-size: var(--text-base);
    font-weight: 700;
    color: var(--color-text);
    margin: var(--space-3) 0 var(--space-2);
  }

  .related-tip-card__desc {
    font-size: var(--text-xs);
    color: var(--color-text-secondary);
    line-height: 1.6;
    margin-bottom: var(--space-4);
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  .related-tip-card__more {
    font-size: var(--text-xs);
    font-weight: 700;
    color: var(--color-brand-light);
    margin-top: auto;
  }

  @media (max-width: 768px) {
    .article-body {
      padding: var(--space-6);
    }
    .article-download-box {
      flex-direction: column;
      text-align: center;
    }
    .article-download-box__right .btn {
      width: 100%;
    }
    .related-tips-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
