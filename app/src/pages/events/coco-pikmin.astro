---
import BaseLayout from '../../layouts/BaseLayout.astro';
import stores from '../../data/coco_stores.json';

const title = 'Pikmin Bloom × CoCo 都可門市 GPS 座標地圖與打卡清單 | GeoSim';
const description = '2026/11/5 ~ 11/22 Pikmin Bloom 與 CoCo 都可合作活動。精選全台 CoCo 門市經緯度 GPS 座標清單。支援手機一鍵直接啟動 GeoSim、整區自動巡航路徑複製、7 天領取冷卻打卡追蹤。';

// Group stores by city
const cities = [
  { id: 'all', name: '全部縣市', count: stores.length },
  { id: '基隆市', name: '基隆市', count: stores.filter((s) => s.city === '基隆市').length },
  { id: '宜蘭縣', name: '宜蘭縣', count: stores.filter((s) => s.city === '宜蘭縣').length },
  { id: '台北市', name: '台北市', count: stores.filter((s) => s.city === '台北市').length }
];

const cityGroups = ['基隆市', '宜蘭縣', '台北市'].map((cityName) => ({
  cityName,
  stores: stores.filter((s) => s.city === cityName),
  routeText: stores
    .filter((s) => s.city === cityName)
    .map((s) => `${s.lat.toFixed(5)},${s.lng.toFixed(5)}`)
    .join('\n')
}));

const allRouteText = stores.map((s) => `${s.lat.toFixed(5)},${s.lng.toFixed(5)}`).join('\n');
const playStoreUrl = 'https://play.google.com/store/apps/details?id=com.kairosvector.geosim';
---

<BaseLayout
  title={title}
  description={description}
  ogTitle="Pikmin Bloom × CoCo 都可門市 GPS 座標地圖與打卡清單"
  ogDescription="全台 CoCo 門市經緯度整理。支援手機一鍵直開 GeoSim 瞬移、整區巡航路徑複製、7天金色花苗冷卻追蹤。"
>
  <main class="coco-page">
    <!-- Breadcrumb -->
    <nav class="breadcrumb-container" aria-label="路徑導覽">
      <div class="container">
        <ol class="breadcrumb">
          <li><a href="/">首頁</a></li>
          <li><a href="/geosim">GeoSim</a></li>
          <li aria-current="page">CoCo 都可活動專區</li>
        </ol>
      </div>
    </nav>

    <!-- Hero Header -->
    <header class="coco-hero">
      <div class="container">
        <div class="coco-hero__badge-wrap">
          <span class="coco-hero__tag">限時合作活動</span>
          <span class="coco-hero__date">2026/11/5 ～ 11/22</span>
        </div>
        <h1 class="coco-hero__title">
          Pikmin Bloom × CoCo 都可門市<br />
          <span class="text-gradient">GPS 座標地圖與 7 天打卡清單</span>
        </h1>
        <p class="coco-hero__subtitle">
          全台 CoCo 都可門市特殊地點開放。收集金色花苗、挑戰「走 2,000 步」獲得紅色「照片鈕扣徽章」飾品皮克敏。
        </p>

        <!-- Rule Highlights -->
        <div class="rule-grid">
          <div class="rule-card">
            <div class="rule-card__icon-box">
              <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <circle cx="12" cy="12" r="10"></circle>
                <polyline points="12 6 12 12 16 14"></polyline>
              </svg>
            </div>
            <div class="rule-card__content">
              <strong>每 7 天領取 1 次</strong>
              <p>每個特殊地點的金色花苗與明信片，7 天內限領一次，網頁提供打卡倒數計時。</p>
            </div>
          </div>

          <div class="rule-card">
            <div class="rule-card__icon-box">
              <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <path d="M13 2L3 14h9l-1 8 10-12h-9l1-8z"></path>
              </svg>
            </div>
            <div class="rule-card__content">
              <strong>走 2,000 步挑戰</strong>
              <p>向下滑動特殊地點觸發任務，完成獲得「紅色照片鈕扣徽章」飾品皮克敏金色花苗。</p>
            </div>
          </div>

          <div class="rule-card">
            <div class="rule-card__icon-box">
              <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <polygon points="3 11 22 2 13 21 11 13 3 11"></polygon>
              </svg>
            </div>
            <div class="rule-card__content">
              <strong>手機直開 GeoSim</strong>
              <p>點擊按鈕直接開啟 GeoSim 定位，若尚未安裝將自動導向 Google Play 商店。</p>
            </div>
          </div>
        </div>

        <!-- Global Quick Actions -->
        <div class="coco-hero__actions">
          <button
            id="btn-copy-all-route"
            class="btn btn--primary btn--lg"
            data-route={allRouteText}
            data-name="全台 48 間 CoCo 門市"
          >
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" style="margin-right: 6px;">
              <rect x="9" y="9" width="13" height="13" rx="2" ry="2"></rect>
              <path d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1"></path>
            </svg>
            一鍵複製第一批 48 店巡航路徑
          </button>
          <a href="#geosim-intro" class="btn btn--outline btn--lg">
            了解 GeoSim 搭配玩法
          </a>
        </div>
      </div>
    </header>

    <!-- Sticky Filter & Search Bar -->
    <section class="coco-controls-section">
      <div class="container">
        <div class="coco-controls-card">
          <!-- City Tabs -->
          <div class="coco-tabs" role="tablist" aria-label="縣市篩選">
            {cities.map((c) => (
              <button
                class={`coco-tab ${c.id === 'all' ? 'active' : ''}`}
                data-city={c.id}
                role="tab"
                aria-selected={c.id === 'all' ? 'true' : 'false'}
              >
                {c.name}
                <span class="coco-tab__count">{c.count}</span>
              </button>
            ))}
          </div>

          <!-- Search & Status Filter Row -->
          <div class="coco-filter-row">
            <div class="search-box">
              <svg class="search-icon" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <circle cx="11" cy="11" r="8"></circle>
                <line x1="21" y1="21" x2="16.65" y2="16.65"></line>
              </svg>
              <input
                type="text"
                id="store-search-input"
                class="search-input"
                placeholder="搜尋門市名稱（例如：內湖、百福、礁溪...）"
                aria-label="搜尋門市名稱"
              />
              <button id="clear-search-btn" class="clear-btn" style="display: none;" aria-label="清除搜尋">✕</button>
            </div>

            <!-- Status Filter -->
            <div class="status-filters">
              <button class="status-filter-btn active" data-status="all">全部</button>
              <button class="status-filter-btn" data-status="todo">尚未前往</button>
              <button class="status-filter-btn" data-status="visited">7 天冷卻中</button>
            </div>
          </div>

          <!-- Result Counter & Quick Reset -->
          <div class="coco-stat-bar">
            <span id="stat-summary-text">顯示 48 家門市</span>
            <div class="stat-pills">
              <span class="stat-pill stat-pill--todo" id="pill-todo-count">待造訪: 48</span>
              <span class="stat-pill stat-pill--done" id="pill-done-count">冷卻中: 0</span>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- Store Lists by City -->
    <section class="coco-list-section">
      <div class="container">
        {cityGroups.map((group) => (
          <div class="city-section" data-city-section={group.cityName}>
            <div class="city-section__header">
              <div class="city-section__title-wrap">
                <h2 class="city-section__title">{group.cityName}</h2>
                <span class="badge badge--geosim">{group.stores.length} 間門市</span>
              </div>
              <button
                class="btn btn--outline btn--sm btn-copy-region-route"
                data-route={group.routeText}
                data-city={group.cityName}
                data-count={group.stores.length}
                title="複製該縣市所有門市座標，可直接貼入 GeoSim 巡航佇列"
              >
                <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" style="margin-right: 4px;">
                  <rect x="9" y="9" width="13" height="13" rx="2" ry="2"></rect>
                  <path d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1"></path>
                </svg>
                複製【{group.cityName}】巡航路徑
              </button>
            </div>

            <div class="stores-grid">
              {group.stores.map((store) => (
                <article
                  class="store-card"
                  data-store-id={store.id}
                  data-city={store.city}
                  data-name={store.name}
                  data-short={store.shortName}
                  data-lat={store.lat}
                  data-lng={store.lng}
                  data-coords={store.coordsText}
                >
                  <div class="store-card__header">
                    <div class="store-card__title-wrap">
                      <span class="store-badge">CoCo</span>
                      <h3 class="store-card__name">{store.shortName}</h3>
                    </div>
                    <span class="store-card__region">{store.city}</span>
                  </div>

                  <!-- Coordinates & Checklist Status -->
                  <div class="store-card__info">
                    <div class="coords-display">
                      <span class="coords-label">GPS:</span>
                      <code class="coords-code">{store.coordsText}</code>
                    </div>

                    <!-- 7-Day Checklist Toggle -->
                    <label class="check-toggle" title="標記今天已刷花苗，開始計算 7 天冷卻">
                      <input
                        type="checkbox"
                        class="check-toggle__input"
                        data-store-id={store.id}
                      />
                      <span class="check-toggle__box"></span>
                      <span class="check-toggle__label">標記已領取</span>
                    </label>
                  </div>

                  <!-- Cooldown Notice Badge -->
                  <div class="cooldown-banner" style="display: none;">
                    <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                      <circle cx="12" cy="12" r="10"></circle>
                      <polyline points="12 6 12 12 16 14"></polyline>
                    </svg>
                    <span class="cooldown-banner__text">7 天冷卻中，下次可刷：<strong class="next-available-date">--/--</strong></span>
                  </div>

                  <!-- Card Action Buttons -->
                  <div class="store-card__actions">
                    <!-- Direct 1-Click Launch to GeoSim (Redirects to Play Store if not installed) -->
                    <button
                      class="btn btn--primary btn--sm btn-launch-geosim"
                      data-lat={store.lat}
                      data-lng={store.lng}
                      data-name={store.name}
                      data-coords={store.coordsText}
                      title="手機直接開啟 GeoSim 瞬移至此門市（未安裝將自動導向商店）"
                    >
                      <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                        <polygon points="5 3 19 12 5 21 5 3"></polygon>
                      </svg>
                      <span>直開 GeoSim</span>
                    </button>

                    <!-- Fast Clipboard Copy -->
                    <button
                      class="btn btn--outline btn--sm btn-copy-coord"
                      data-coords={store.coordsText}
                      data-name={store.shortName}
                      title="複製經緯度座標"
                    >
                      <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                        <rect x="9" y="9" width="13" height="13" rx="2" ry="2"></rect>
                        <path d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1"></path>
                      </svg>
                      <span>複製座標</span>
                    </button>

                    <!-- Web Share Button (Optional System Share Sheet) -->
                    <button
                      class="btn btn--icon btn--sm btn-share-store"
                      data-lat={store.lat}
                      data-lng={store.lng}
                      data-name={store.name}
                      data-coords={store.coordsText}
                      title="透過系統選單分享"
                      aria-label="系統分享"
                    >
                      <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                        <circle cx="18" cy="5" r="3"></circle>
                        <circle cx="6" cy="12" r="3"></circle>
                        <circle cx="18" cy="19" r="3"></circle>
                        <line x1="8.59" y1="13.51" x2="15.42" y2="17.49"></line>
                        <line x1="15.41" y1="6.51" x2="8.59" y2="10.49"></line>
                      </svg>
                    </button>

                    <!-- Google Maps Link -->
                    <a
                      href={`https://www.google.com/maps/search/?api=1&query=${store.lat},${store.lng}`}
                      target="_blank"
                      rel="noopener noreferrer"
                      class="btn btn--icon btn--sm btn-gmap"
                      title="在 Google Maps 查看實體街景位置"
                      aria-label={`${store.shortName} Google Maps`}
                    >
                      <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                        <path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"></path>
                        <circle cx="12" cy="10" r="3"></circle>
                      </svg>
                    </a>
                  </div>
                </article>
              ))}
            </div>
          </div>
        ))}

        <!-- No Results Fallback -->
        <div id="no-results-box" class="no-results" style="display: none;">
          <div class="no-results__icon">
            <svg width="40" height="40" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
              <circle cx="11" cy="11" r="8"></circle>
              <line x1="21" y1="21" x2="16.65" y2="16.65"></line>
            </svg>
          </div>
          <h3>找不到符合條件的 CoCo 門市</h3>
          <p>請嘗試放寬搜尋關鍵字或重設篩選條件。</p>
          <button id="btn-reset-filters" class="btn btn--outline">重設篩選條件</button>
        </div>
      </div>
    </section>

    <!-- GeoSim Introduction Section (Product Spotlight) -->
    <section id="geosim-intro" class="geosim-intro-section">
      <div class="container">
        <div class="geosim-intro-card">
          <div class="geosim-intro-header">
            <div class="geosim-intro-logo">
              <img
                src="/images/geosim-icon.png"
                alt="GeoSim App Icon"
                width="72"
                height="72"
                class="geosim-app-img"
              />
            </div>
            <div class="geosim-intro-heading">
              <span class="badge badge--geosim">推薦搭配工具</span>
              <h2 class="geosim-intro-title">GeoSim — 自由定位，探索無界限</h2>
              <p class="geosim-intro-tagline">
                專為 Android 打造的 GPS 位置模擬與路線規劃測試工具。適合遊戲玩家探索地圖、收集飾品皮克敏，以及開發者測試位置服務。
              </p>
            </div>
          </div>

          <!-- Feature Columns for Pikmin Players -->
          <div class="geosim-features-grid">
            <div class="feature-item">
              <div class="feature-item__icon-wrap">
                <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                  <circle cx="12" cy="12" r="10"></circle>
                  <polygon points="12 8 8 12 12 16 16 12 12 8"></polygon>
                </svg>
              </div>
              <h3 class="feature-item__title">懸浮虛擬搖桿</h3>
              <p class="feature-item__desc">
                遊戲上方懸浮覆蓋控制面板，支援隨意拖曳與 360 度方向控制，自訂行走速度（1~24 km/h），在家也能自然散步。
              </p>
            </div>

            <div class="feature-item">
              <div class="feature-item__icon-wrap">
                <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                  <polyline points="22 12 18 12 15 21 9 3 6 12 2 12"></polyline>
                </svg>
              </div>
              <h3 class="feature-item__title">依線巡航與自動折返</h3>
              <p class="feature-item__desc">
                貼入多間門市座標即可自動連成路徑，支援平滑速度前進與自動循環，輕鬆達成「走 2,000 步」地點挑戰。
              </p>
            </div>

            <div class="feature-item">
              <div class="feature-item__icon-wrap">
                <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                  <polygon points="1 6 1 22 8 18 16 22 23 18 23 2 16 6 8 2 1 6"></polygon>
                  <line x1="8" y1="2" x2="8" y2="18"></line>
                  <line x1="16" y1="6" x2="16" y2="22"></line>
                </svg>
              </div>
              <h3 class="feature-item__title">區內漫步隨機遊走</h3>
              <p class="feature-item__desc">
                在地圖選定 3 個以上頂點繪製多邊形區域，自動在範圍內隨機自然漫步，模擬最真實的戶外散步走動軌跡。
              </p>
            </div>

            <div class="feature-item">
              <div class="feature-item__icon-wrap">
                <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                  <path d="M19 21l-7-5-7 5V5a2 2 0 0 1 2-2h10a2 2 0 0 1 2 2z"></path>
                </svg>
              </div>
              <h3 class="feature-item__title">自訂書籤與純點庫</h3>
              <p class="feature-item__desc">
                支援建立景點資料夾、標籤分類與匯入匯出備份。官方更提供全台純點座標庫與每週主題巡航專欄。
              </p>
            </div>
          </div>

          <!-- Download Action Bar -->
          <div class="geosim-intro-actions">
            <a
              href={playStoreUrl}
              target="_blank"
              rel="noopener noreferrer"
              class="btn btn--primary btn--lg btn-playstore"
            >
              <svg width="20" height="20" viewBox="0 0 24 24" fill="currentColor">
                <path d="M3.609 1.814L13.792 12 3.61 22.186a.996.996 0 01-.61-.92V2.734a1 1 0 01.609-.92zm10.89 10.893l2.302 2.302-10.937 6.333 8.635-8.635zm3.199-3.199l2.302 1.329-2.822 1.634-2.116-2.116 2.636-2.847zm-4.529-4.528L4.864 1.367 15.8 7.7l-2.63 2.88z"/>
              </svg>
              前往 Google Play 免費下載 GeoSim
            </a>
            <a href="/geosim" class="btn btn--outline btn--lg">
              閱讀 GeoSim 完整功能介紹
            </a>
            <a href="/geosim/spot-map" class="btn btn--ghost btn--lg">
              探索全球純點座標庫
            </a>
          </div>
        </div>
      </div>
    </section>

    <!-- How to Use Section -->
    <section id="how-to-use" class="how-to-use-section">
      <div class="container">
        <div class="how-to-use-card">
          <h2 class="how-to-use__title">如何在手機上搭配 GeoSim 使用</h2>
          <div class="steps-grid">
            <div class="step-card">
              <div class="step-card__number">1</div>
              <h3 class="step-card__title">直開 GeoSim（自動導向商店）</h3>
              <p>
                在手機瀏覽器點擊門市卡片上的 <strong>「直開 GeoSim」</strong> 按鈕，系統將直接啟動 App 並定位在該門市。若尚未安裝，將自動前往 Google Play 商店下載。
              </p>
            </div>
            <div class="step-card">
              <div class="step-card__number">2</div>
              <h3 class="step-card__title">複製座標貼上</h3>
              <p>
                點擊卡片上的 <strong>「複製座標」</strong>，經緯度直接複製進剪貼簿。切換到 GeoSim 主畫面或懸浮控制器的搜尋欄即可貼上前往。
              </p>
            </div>
            <div class="step-card">
              <div class="step-card__number">3</div>
              <h3 class="step-card__title">整區巡航自動走 2,000 步</h3>
              <p>
                點擊各區頂部的 <strong>「複製巡航路徑」</strong>，可一次取得該縣市所有門市路徑。貼入 GeoSim 的「依線巡航」，自動掛機散步 2,000 步並依序抵達門市領花苗。
              </p>
            </div>
            <div class="step-card">
              <div class="step-card__number">4</div>
              <h3 class="step-card__title">7 天打卡記錄</h3>
              <p>
                每刷完一間門市，勾選 <strong>「標記已領取」</strong>，手機會自動記錄日期並鎖定 7 天倒數，下次可刷日期一清二楚。
              </p>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- Floating Copy Toast (Clean, no emoji) -->
    <div id="copy-toast" class="copy-toast" role="alert" aria-live="polite">
      已複製座標，可貼入 GeoSim
    </div>
  </main>
</BaseLayout>

<script is:inline>
  (function () {
    const STORAGE_KEY_PREFIX = 'coco_visited_';
    const SEVEN_DAYS_MS = 7 * 24 * 60 * 60 * 1000;
    const PLAY_STORE_URL = 'https://play.google.com/store/apps/details?id=com.kairosvector.geosim';

    let currentCity = 'all';
    let currentStatus = 'all';
    let currentSearch = '';

    const toast = document.getElementById('copy-toast');
    let toastTimer = null;

    function showToast(msg) {
      if (!toast) return;
      toast.textContent = msg;
      toast.classList.add('show');
      clearTimeout(toastTimer);
      toastTimer = setTimeout(() => {
        toast.classList.remove('show');
      }, 2400);
    }

    // 1. Visited Status Handling (7-day cooldown in localStorage)
    function getVisitedTime(storeId) {
      try {
        const val = localStorage.getItem(STORAGE_KEY_PREFIX + storeId);
        return val ? parseInt(val, 10) : 0;
      } catch (e) {
        return 0;
      }
    }

    function setVisited(storeId, isVisited) {
      try {
        if (isVisited) {
          localStorage.setItem(STORAGE_KEY_PREFIX + storeId, Date.now().toString());
        } else {
          localStorage.removeItem(STORAGE_KEY_PREFIX + storeId);
        }
      } catch (e) {}
      updateAllStoreStates();
      filterStores();
    }

    function formatDate(ms) {
      const d = new Date(ms);
      return `${d.getMonth() + 1}/${d.getDate()} ${String(d.getHours()).padStart(2, '0')}:${String(d.getMinutes()).padStart(2, '0')}`;
    }

    function updateAllStoreStates() {
      const now = Date.now();
      let totalTodo = 0;
      let totalVisited = 0;

      document.querySelectorAll('.store-card').forEach((card) => {
        const storeId = card.getAttribute('data-store-id');
        const visitedTime = getVisitedTime(storeId);
        const checkbox = card.querySelector('.check-toggle__input');
        const banner = card.querySelector('.cooldown-banner');
        const dateSpan = card.querySelector('.next-available-date');

        const isCooldown = visitedTime && (now - visitedTime < SEVEN_DAYS_MS);

        if (isCooldown) {
          card.classList.add('is-visited');
          if (checkbox) checkbox.checked = true;
          if (banner) {
            banner.style.display = 'flex';
            const nextDate = visitedTime + SEVEN_DAYS_MS;
            if (dateSpan) dateSpan.textContent = formatDate(nextDate);
          }
          totalVisited++;
        } else {
          card.classList.remove('is-visited');
          if (checkbox) checkbox.checked = false;
          if (banner) banner.style.display = 'none';
          totalTodo++;
        }
      });

      const pillTodo = document.getElementById('pill-todo-count');
      const pillDone = document.getElementById('pill-done-count');
      if (pillTodo) pillTodo.textContent = `待造訪: ${totalTodo}`;
      if (pillDone) pillDone.textContent = `冷卻中: ${totalVisited}`;
    }

    // 2. Direct 1-Click Launch to GeoSim
    // (Uses Android Intent URI with S.browser_fallback_url + JS timeout to ensure redirect to Play Store if not installed)
    async function launchGeoSim(lat, lng, storeName, coordsText) {
      // (1) 先寫入剪貼簿備用
      try {
        await navigator.clipboard.writeText(coordsText);
      } catch (e) {
        const ta = document.createElement('textarea');
        ta.value = coordsText;
        document.body.appendChild(ta);
        ta.select();
        document.execCommand('copy');
        document.body.removeChild(ta);
      }

      // (2) 若在 GeoSim 內嵌 WebView，直接呼叫 JS Bridge
      if (window.AndroidGeoSim && typeof window.AndroidGeoSim.setCoordinate === 'function') {
        window.AndroidGeoSim.setCoordinate(parseFloat(lat), parseFloat(lng), storeName);
        showToast(`已帶入 GeoSim: ${storeName}`);
        return;
      }

      // (3) 嘗試直接開啟 GeoSim
      showToast(`正在開啟 GeoSim...`);
      const isAndroid = /Android/i.test(navigator.userAgent);
      const encodedName = encodeURIComponent(storeName);
      const fallbackUrlEncoded = encodeURIComponent(PLAY_STORE_URL);

      if (isAndroid) {
        // 標準 Android Intent URI，並宣告 S.browser_fallback_url
        // 當手機未安裝 com.kairosvector.geosim 時，系統將自動導向 Google Play 商店
        const intentUri = `intent://location?lat=${lat}&lng=${lng}&label=${encodedName}#Intent;scheme=geosim;package=com.kairosvector.geosim;S.browser_fallback_url=${fallbackUrlEncoded};end`;

        // 雙重保險：設定 1.8 秒檢查，若仍停留在本頁且未切換背景，則代表開啟失敗或瀏覽器未處理 fallback，手動導向 Play 商店
        let appOpened = false;
        const fallbackTimer = setTimeout(() => {
          if (!appOpened && !document.hidden) {
            window.location.href = PLAY_STORE_URL;
          }
        }, 1800);

        const onVisibilityChange = () => {
          if (document.hidden) {
            appOpened = true;
            clearTimeout(fallbackTimer);
          }
        };
        window.addEventListener('visibilitychange', onVisibilityChange, { once: true });
        window.addEventListener('pagehide', onVisibilityChange, { once: true });

        window.location.href = intentUri;
      } else {
        // 非 Android 環境（例如桌面或 iOS），導向商店或 custom scheme
        window.location.href = PLAY_STORE_URL;
      }
    }

    // 2.1 透過系統分享選單分享 (點擊分享圖示時)
    async function shareStore(lat, lng, storeName, coordsText) {
      if (navigator.share) {
        try {
          await navigator.share({
            title: storeName,
            text: coordsText
          });
          showToast(`已開啟分享選單`);
        } catch (e) {}
      } else {
        await navigator.clipboard.writeText(coordsText);
        showToast(`已複製 ${storeName} 座標`);
      }
    }

    // 3. Share or Copy Multi-Point Route
    async function shareOrCopyRoute(routeText, routeTitle, count) {
      if (window.AndroidGeoSim && typeof window.AndroidGeoSim.setRoute === 'function') {
        window.AndroidGeoSim.setRoute(routeText);
        showToast(`已匯入 ${count} 處巡航座標至 GeoSim`);
        return;
      }

      try {
        await navigator.clipboard.writeText(routeText);
      } catch (e) {
        const ta = document.createElement('textarea');
        ta.value = routeText;
        document.body.appendChild(ta);
        ta.select();
        document.execCommand('copy');
        document.body.removeChild(ta);
      }
      showToast(`已複製 ${count} 間門市巡航路徑，可直接貼入 GeoSim`);
    }

    // 4. Filtering Logic
    function filterStores() {
      const q = currentSearch.trim().toLowerCase();
      let visibleCount = 0;

      document.querySelectorAll('.store-card').forEach((card) => {
        const city = card.getAttribute('data-city');
        const name = card.getAttribute('data-name').toLowerCase();
        const shortName = card.getAttribute('data-short').toLowerCase();
        const coords = card.getAttribute('data-coords');
        const isVisited = card.classList.contains('is-visited');

        // City match
        const cityMatch = (currentCity === 'all' || city === currentCity);

        // Status match
        let statusMatch = true;
        if (currentStatus === 'todo') statusMatch = !isVisited;
        if (currentStatus === 'visited') statusMatch = isVisited;

        // Keyword match
        let searchMatch = true;
        if (q) {
          searchMatch = name.includes(q) || shortName.includes(q) || coords.includes(q);
        }

        if (cityMatch && statusMatch && searchMatch) {
          card.style.display = '';
          visibleCount++;
        } else {
          card.style.display = 'none';
        }
      });

      // Show/Hide City Sections if all children are hidden
      document.querySelectorAll('.city-section').forEach((sec) => {
        const secCity = sec.getAttribute('data-city-section');
        const anyVisible = sec.querySelectorAll('.store-card:not([style*="display: none"])').length > 0;
        if (currentCity !== 'all' && secCity !== currentCity) {
          sec.style.display = 'none';
        } else {
          sec.style.display = anyVisible ? '' : 'none';
        }
      });

      const statText = document.getElementById('stat-summary-text');
      if (statText) statText.textContent = `顯示 ${visibleCount} 家門市`;

      const noResults = document.getElementById('no-results-box');
      if (noResults) noResults.style.display = visibleCount === 0 ? 'block' : 'none';
    }

    // 5. Event Listeners Setup
    document.addEventListener('DOMContentLoaded', () => {
      updateAllStoreStates();

      // Checkbox changes
      document.querySelectorAll('.check-toggle__input').forEach((cb) => {
        cb.addEventListener('change', (e) => {
          const storeId = e.target.getAttribute('data-store-id');
          setVisited(storeId, e.target.checked);
        });
      });

      // Direct Launch to GeoSim
      document.querySelectorAll('.btn-launch-geosim').forEach((btn) => {
        btn.addEventListener('click', () => {
          const lat = btn.getAttribute('data-lat');
          const lng = btn.getAttribute('data-lng');
          const name = btn.getAttribute('data-name');
          const coords = btn.getAttribute('data-coords');
          launchGeoSim(lat, lng, name, coords);
        });
      });

      // Copy Single Coordinate
      document.querySelectorAll('.btn-copy-coord').forEach((btn) => {
        btn.addEventListener('click', async () => {
          const coords = btn.getAttribute('data-coords');
          const name = btn.getAttribute('data-name');
          try {
            await navigator.clipboard.writeText(coords);
          } catch (e) {
            const ta = document.createElement('textarea');
            ta.value = coords;
            document.body.appendChild(ta);
            ta.select();
            document.execCommand('copy');
            document.body.removeChild(ta);
          }
          showToast(`已複製 ${name} 座標，可貼入 GeoSim`);
        });
      });

      // System Share Button
      document.querySelectorAll('.btn-share-store').forEach((btn) => {
        btn.addEventListener('click', () => {
          const lat = btn.getAttribute('data-lat');
          const lng = btn.getAttribute('data-lng');
          const name = btn.getAttribute('data-name');
          const coords = btn.getAttribute('data-coords');
          shareStore(lat, lng, name, coords);
        });
      });

      // Copy Region Route
      document.querySelectorAll('.btn-copy-region-route').forEach((btn) => {
        btn.addEventListener('click', () => {
          const route = btn.getAttribute('data-route');
          const city = btn.getAttribute('data-city');
          const count = btn.getAttribute('data-count');
          shareOrCopyRoute(route, `CoCo ${city} 巡航路線`, count);
        });
      });

      // Copy All Route
      const copyAllBtn = document.getElementById('btn-copy-all-route');
      if (copyAllBtn) {
        copyAllBtn.addEventListener('click', () => {
          const route = copyAllBtn.getAttribute('data-route');
          const name = copyAllBtn.getAttribute('data-name');
          shareOrCopyRoute(route, name, 48);
        });
      }

      // City Tabs
      document.querySelectorAll('.coco-tab').forEach((tab) => {
        tab.addEventListener('click', () => {
          document.querySelectorAll('.coco-tab').forEach((t) => t.classList.remove('active'));
          tab.classList.add('active');
          currentCity = tab.getAttribute('data-city');
          filterStores();
        });
      });

      // Status Filter
      document.querySelectorAll('.status-filter-btn').forEach((btn) => {
        btn.addEventListener('click', () => {
          document.querySelectorAll('.status-filter-btn').forEach((b) => b.classList.remove('active'));
          btn.classList.add('active');
          currentStatus = btn.getAttribute('data-status');
          filterStores();
        });
      });

      // Search Input
      const searchInput = document.getElementById('store-search-input');
      const clearBtn = document.getElementById('clear-search-btn');
      if (searchInput) {
        searchInput.addEventListener('input', (e) => {
          currentSearch = e.target.value;
          if (clearBtn) clearBtn.style.display = currentSearch ? 'block' : 'none';
          filterStores();
        });
      }

      if (clearBtn) {
        clearBtn.addEventListener('click', () => {
          if (searchInput) searchInput.value = '';
          currentSearch = '';
          clearBtn.style.display = 'none';
          filterStores();
        });
      }

      const resetBtn = document.getElementById('btn-reset-filters');
      if (resetBtn) {
        resetBtn.addEventListener('click', () => {
          currentCity = 'all';
          currentStatus = 'all';
          currentSearch = '';
          if (searchInput) searchInput.value = '';
          if (clearBtn) clearBtn.style.display = 'none';
          document.querySelectorAll('.coco-tab').forEach((t) => t.classList.remove('active'));
          document.querySelector('.coco-tab[data-city="all"]')?.classList.add('active');
          document.querySelectorAll('.status-filter-btn').forEach((b) => b.classList.remove('active'));
          document.querySelector('.status-filter-btn[data-status="all"]')?.classList.add('active');
          filterStores();
        });
      }
    });
  })();
</script>

