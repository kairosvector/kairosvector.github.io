---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import stores from '../../../data/coco_stores.json';

const title = 'Pikmin Bloom × CoCo 都可全台門市 GPS 座標地圖與打卡清單 (331店完整版) | GeoSim';
const description = '2026/11/5 ~ 11/22 Pikmin Bloom 與 CoCo 都可合作活動。全台 331 間 CoCo 門市經緯度 GPS 座標完整清單，涵蓋雙北、基隆、桃竹苗、中南部、金門等 15 縣市。支援手機一鍵直接啟動 GeoSim、直開遊戲帶座標、縣市快速切換、7 天領取冷卻打卡追蹤。';

// Geographic ordering of Taiwan counties and cities
const CITY_ORDER = [
  '基隆市',
  '台北市',
  '新北市',
  '桃園市',
  '新竹市',
  '新竹縣',
  '苗栗縣',
  '台中市',
  '彰化縣',
  '南投縣',
  '雲林縣',
  '台南市',
  '高雄市',
  '宜蘭縣',
  '金門縣'
];

// Extract available cities dynamically, ordered geographically
const availableCities = Array.from(new Set(stores.map((s) => s.city))).sort((a, b) => {
  const ia = CITY_ORDER.indexOf(a);
  const ib = CITY_ORDER.indexOf(b);
  return (ia === -1 ? 99 : ia) - (ib === -1 ? 99 : ib);
});

const cities = [
  { id: 'all', name: '全區', count: stores.length },
  ...availableCities.map((c) => ({
    id: c,
    name: c,
    count: stores.filter((s) => s.city === c).length
  }))
];

const cityGroups = availableCities.map((cityName) => {
  const cityStores = stores.filter((s) => s.city === cityName);
  return {
    cityName,
    stores: cityStores,
    routeText: cityStores.map((s) => `${s.lat.toFixed(5)},${s.lng.toFixed(5)}`).join('\n')
  };
});

const allRouteText = stores.map((s) => `${s.lat.toFixed(5)},${s.lng.toFixed(5)}`).join('\n');
const playStoreUrl = 'https://play.google.com/store/apps/details?id=com.kairosvector.geosim';
---

<BaseLayout
  title={`[Staging 測試版] ` + title}
  description={description}
  ogTitle="Pikmin Bloom × CoCo 都可門市 GPS 座標地圖與打卡清單"
  ogDescription="全台 CoCo 門市經緯度整理。支援手機一鍵直開 GeoSim 瞬移、整區巡航路徑複製、7天金色花苗冷卻追蹤。"
  forcedTheme="vibrant"
  hideThemeSwitcher={true}
>
  <main class="coco-page">
    <!-- Staging Environment Indicator Banner -->
    <div style="background: #FEF3C7; border-bottom: 2px solid #F59E0B; padding: 0.5rem 1rem; text-align: center; font-size: 0.875rem; font-weight: 700; color: #92400E; z-index: 50; position: relative;">
      [測試預覽環境 Staging] 此頁面用於驗證新功能，測試完畢確認無誤後將同步發布至正式版。
    </div>
    <!-- In-App Browser (LINE / FB) Guidance Bar -->
    <div id="inapp-browser-bar" class="inapp-browser-bar" style="display: none;">
      <div class="container inapp-browser-bar__inner">
        <div class="inapp-browser-bar__text">
          <strong>提示：</strong>您正在使用 LINE 內建瀏覽器，部分直開與打卡紀錄將受限。請點右下角「…」選擇<strong>「在 Safari / 瀏覽器中開啟」</strong>以獲得最佳體驗！
        </div>
        <button id="btn-close-inapp-bar" class="inapp-browser-bar__close" aria-label="關閉提示">✕</button>
      </div>
    </div>

    <!-- Breadcrumb -->
    <nav class="breadcrumb-container" aria-label="路徑導覽">
      <div class="container">
        <ol class="breadcrumb">
          <li><a href="/">首頁</a></li>
          <li><a href="/geosim">GeoSim</a></li>
          <li aria-current="page">CoCo 都可活動專區</li>
        </ol>
      </div>
    </nav>

    <!-- Clean Compact Hero Header -->
    <header class="coco-hero">
      <div class="container">
        <div class="coco-hero__badge-wrap">
          <span class="coco-hero__tag">限時合作活動</span>
          <span class="coco-hero__date">11/5 ～ 11/22 · 全台 15 縣市</span>
        </div>
        <h1 class="coco-hero__title">
          Pikmin Bloom × CoCo 都可門市<br />
          <span class="text-gradient">全台 331 店 GPS 座標與 7 天打卡清單</span>
        </h1>

        <!-- Compact GeoSim Recommendation Card (Inspired by Version B) -->
        <aside class="geosim-compact-ad" aria-label="GeoSim 下載推薦">
          <div class="ad-icon" aria-hidden="true">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
              <path d="M20 10c0 6-8 12-8 12s-8-6-8-12a8 8 0 0 1 16 0z"></path>
              <circle cx="12" cy="10" r="3"></circle>
            </svg>
          </div>
          <div class="ad-content">
            <div class="ad-head">
              <span class="ad-tag">跑店神器 · 免費下載</span>
              <h2 class="ad-title">人還沒到，定位先到 CoCo</h2>
            </div>
            <p class="ad-desc">
              331 間門市不用手打座標。點一下用 GeoSim 落點到店門口，再開遊戲領花苗，跑店快人一步。
            </p>
            <div class="ad-action-line">
              <a class="ad-cta-btn" href={playStoreUrl} target="_blank" rel="noopener">
                <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                  <path d="M12 3v12"></path>
                  <path d="M6.5 10.5L12 16l5.5-5.5"></path>
                  <path d="M4 20h16"></path>
                </svg>
                免費下載 GeoSim
              </a>
              <span class="ad-note">清單中點「用 GeoSim 打開」，未安裝將自動導向商店</span>
            </div>
          </div>
        </aside>
      </div>
    </header>

    <!-- Sticky Controls Bar (County & Status Multi-Dimension Filtering) -->
    <section class="coco-controls-section">
      <div class="container">
        <!-- Top Status Bar: 已領取計數 + 搜尋與巡航工具按鈕 -->
        <div class="muse-top-bar">
          <div class="muse-top-bar__counter">
            <span class="muse-counter-label">已領取</span>
            <span class="muse-counter-done" id="pill-done-count">0</span>
            <span class="muse-counter-sep">/</span>
            <span class="muse-counter-total" id="pill-total-count">{stores.length}</span>
          </div>

          <!-- Tools Toggle Button -->
          <button id="btn-toggle-tools" class="tools-toggle-btn" aria-expanded="false" aria-controls="muse-tools-panel">
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <circle cx="11" cy="11" r="8"></circle>
              <line x1="21" y1="21" x2="16.65" y2="16.65"></line>
            </svg>
            <span>搜尋與巡航工具</span>
            <svg class="tools-toggle-arrow" width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
              <polyline points="6 9 12 15 18 9"></polyline>
            </svg>
          </button>
        </div>

        <!-- Tier 1: 依縣市過濾 (15 縣市快速切換水平膠囊列) -->
        <div class="tier-city-bar" role="tablist" aria-label="縣市篩選">
          {cities.map((c) => (
            <button
              class={`city-pill ${c.id === 'all' ? 'active' : ''}`}
              data-city={c.id}
              role="tab"
              aria-selected={c.id === 'all' ? 'true' : 'false'}
            >
              {c.name} <span class="pill-count">{c.count}</span>
            </button>
          ))}
        </div>

        <!-- Tier 2: 依狀態過濾 (全部 / 尚未前往 / 7天冷卻中 / 冷卻完畢可再次領取) -->
        <div class="tier-status-bar" role="tablist" aria-label="冷卻狀態篩選">
          <button class="status-pill active" data-status="all">全部 ({stores.length})</button>
          <button class="status-pill" data-status="todo">尚未前往 (<span id="count-todo">{stores.length}</span>)</button>
          <button class="status-pill" data-status="cooling">冷卻中 (<span id="count-cooling">0</span>)</button>
          <button class="status-pill" data-status="ready">冷卻完畢 (<span id="count-ready">0</span>)</button>
        </div>

        <!-- Expandable Tools & Search Panel -->
        <div id="muse-tools-panel" class="muse-tools-panel" style="display: none;">
          <div class="tools-inner-box">
            <div class="search-box">
              <svg class="search-icon" width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <circle cx="11" cy="11" r="8"></circle>
                <line x1="21" y1="21" x2="16.65" y2="16.65"></line>
              </svg>
              <input
                type="text"
                id="store-search-input"
                class="search-input"
                placeholder="搜尋門市名稱（例如：板橋、三民、新豐...）"
                aria-label="搜尋門市名稱"
              />
              <button id="clear-search-btn" class="clear-btn" style="display: none;" aria-label="清除搜尋">✕</button>
            </div>
            <div class="tools-action-row">
              <button
                class="btn btn--outline btn--sm btn-copy-all-route"
                data-route={allRouteText}
                data-name="全台 331 間 CoCo 門市"
              >
                複製全台 331 店巡航路徑
              </button>
              <span id="stat-summary-text">顯示 {stores.length} 家門市</span>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- Store Lists by City -->
    <section class="coco-list-section">
      <div class="container">
        {cityGroups.map((group) => (
          <div class="city-section" data-city-section={group.cityName}>
            <div class="city-section__header">
              <div class="city-section__title-wrap">
                <h2 class="city-section__title">{group.cityName}</h2>
                <span class="badge badge--geosim">{group.stores.length} 間門市</span>
              </div>
              <button
                class="btn btn--outline btn--sm btn-copy-region-route"
                data-route={group.routeText}
                data-city={group.cityName}
                data-count={group.stores.length}
                title="複製該縣市所有門市座標，可直接貼入 GeoSim 巡航佇列"
              >
                <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" style="margin-right: 4px;">
                  <rect x="9" y="9" width="13" height="13" rx="2" ry="2"></rect>
                  <path d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1"></path>
                </svg>
                複製【{group.cityName}】巡航路徑
              </button>
            </div>

            <div class="stores-grid">
              {group.stores.map((store) => (
                <article
                  class="store-card muse-card"
                  data-store-id={store.id}
                  data-city={store.city}
                  data-name={store.name}
                  data-short={store.shortName}
                  data-lat={store.lat}
                  data-lng={store.lng}
                  data-coords={store.coordsText}
                >
                  <!-- Line 1: Big Rounded Checkbox & Bold 22px Store Name -->
                  <div class="muse-card__head">
                    <label class="muse-checkbox" title="勾選代表已刷花苗，開始計算 7 天冷卻">
                      <input
                        type="checkbox"
                        class="check-toggle__input"
                        data-store-id={store.id}
                        aria-label={`標記 ${store.shortName} 已領取花苗`}
                      />
                      <span class="muse-checkbox__box"></span>
                    </label>
                    <h3 class="muse-card__title">{store.shortName}</h3>
                  </div>

                  <!-- Line 2: GPS Coordinates (Large, clear, aligned under store title) -->
                  <div class="muse-card__coords">
                    {store.coordsText}
                  </div>

                  <!-- 7-Day Cooldown Notice (Appears when visited) -->
                  <div class="cooldown-banner muse-cooldown-badge" style="display: none;">
                    <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                      <circle cx="12" cy="12" r="10"></circle>
                      <polyline points="12 6 12 12 16 14"></polyline>
                    </svg>
                    <span class="cooldown-banner__text">7 天冷卻中，下次可刷：<strong class="next-available-date">--/--</strong></span>
                  </div>

                  <!-- Line 3 & 4: Action Buttons (Warm beige & soft peach colors matching screenshot) -->
                  <div class="muse-card__actions">
                    <!-- Button Row 1: 複製座標 & 看遊戲地圖 -->
                    <div class="muse-btn-row">
                      <button
                        class="muse-btn muse-btn--neutral btn-copy-coord"
                        data-coords={store.coordsText}
                        data-name={store.shortName}
                        title="複製經緯度座標"
                      >
                        <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                          <rect x="9" y="9" width="13" height="13" rx="2" ry="2"></rect>
                          <path d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1"></path>
                        </svg>
                        <span>複製座標</span>
                      </button>

                      <button
                        class="muse-btn muse-btn--pikmin btn-launch-pikmin"
                        data-lat={store.lat}
                        data-lng={store.lng}
                        data-name={store.shortName}
                        title="在 Pikmin Bloom 查看大區域地圖（未安裝將導向商店）"
                      >
                        <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                          <polygon points="5 3 19 12 5 21 5 3"></polygon>
                        </svg>
                        <span>看遊戲地圖</span>
                      </button>
                    </div>

                    <!-- Button Row 2: 用 GeoSim 打開 & 地圖 -->
                    <div class="muse-btn-row">
                      <button
                        class="muse-btn muse-btn--geosim btn-launch-geosim"
                        data-lat={store.lat}
                        data-lng={store.lng}
                        data-name={store.name}
                        data-coords={store.coordsText}
                        title="用 GeoSim 開啟此座標（未安裝將導向商店）"
                      >
                        <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                          <circle cx="18" cy="5" r="3"></circle>
                          <circle cx="6" cy="12" r="3"></circle>
                          <circle cx="18" cy="19" r="3"></circle>
                          <line x1="8.59" y1="13.51" x2="15.42" y2="17.49"></line>
                          <line x1="15.41" y1="6.51" x2="8.59" y2="10.49"></line>
                        </svg>
                        <span>用 GeoSim 打開</span>
                      </button>

                      <a
                        href={`https://www.google.com/maps/search/?api=1&query=${store.lat},${store.lng}`}
                        target="_blank"
                        rel="noopener noreferrer"
                        class="muse-btn muse-btn--neutral btn-gmap"
                        title="在 Google Maps 查看位置"
                      >
                        <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                          <path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"></path>
                          <circle cx="12" cy="10" r="3"></circle>
                        </svg>
                        <span>地圖</span>
                      </a>
                    </div>
                  </div>
                </article>
              ))}
            </div>
          </div>
        ))}

        <!-- No Results Fallback -->
        <div id="no-results-box" class="no-results" style="display: none;">
          <div class="no-results__icon">
            <svg width="40" height="40" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
              <circle cx="11" cy="11" r="8"></circle>
              <line x1="21" y1="21" x2="16.65" y2="16.65"></line>
            </svg>
          </div>
          <h3>找不到符合條件的 CoCo 門市</h3>
          <p>請嘗試放寬搜尋關鍵字或重設篩選條件。</p>
          <button id="btn-reset-filters" class="btn btn--outline">重設篩選條件</button>
        </div>
      </div>
    </section>

    <!-- GeoSim Introduction Section (Product Spotlight) -->
    <section id="geosim-intro" class="geosim-intro-section">
      <div class="container">
        <div class="geosim-intro-card">
          <div class="geosim-intro-header">
            <div class="geosim-intro-logo">
              <img
                src="/images/geosim-icon.png"
                alt="GeoSim App Icon"
                width="72"
                height="72"
                class="geosim-app-img"
              />
            </div>
            <div class="geosim-intro-heading">
              <span class="badge badge--geosim">推薦搭配工具</span>
              <h2 class="geosim-intro-title">GeoSim — 自由定位，探索無界限</h2>
              <p class="geosim-intro-tagline">
                專為 Android 打造的 GPS 位置模擬與路線規劃測試工具。適合遊戲玩家探索地圖、收集飾品皮克敏，以及開發者測試位置服務。
              </p>
            </div>
          </div>

          <!-- Feature Columns for Pikmin Players -->
          <div class="geosim-features-grid">
            <div class="feature-item">
              <div class="feature-item__icon-wrap">
                <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                  <circle cx="12" cy="12" r="10"></circle>
                  <polygon points="12 8 8 12 12 16 16 12 12 8"></polygon>
                </svg>
              </div>
              <h3 class="feature-item__title">懸浮虛擬搖桿</h3>
              <p class="feature-item__desc">
                遊戲上方懸浮覆蓋控制面板，支援隨意拖曳與 360 度方向控制，自訂行走速度（1~24 km/h），在家也能自然散步。
              </p>
            </div>

            <div class="feature-item">
              <div class="feature-item__icon-wrap">
                <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                  <polyline points="22 12 18 12 15 21 9 3 6 12 2 12"></polyline>
                </svg>
              </div>
              <h3 class="feature-item__title">依線巡航與自動折返</h3>
              <p class="feature-item__desc">
                貼入多間門市座標即可自動連成路徑，支援平滑速度前進與自動循環，輕鬆達成「走 2,000 步」地點挑戰。
              </p>
            </div>

            <div class="feature-item">
              <div class="feature-item__icon-wrap">
                <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                  <polygon points="1 6 1 22 8 18 16 22 23 18 23 2 16 6 8 2 1 6"></polygon>
                  <line x1="8" y1="2" x2="8" y2="18"></line>
                  <line x1="16" y1="6" x2="16" y2="22"></line>
                </svg>
              </div>
              <h3 class="feature-item__title">區內漫步隨機遊走</h3>
              <p class="feature-item__desc">
                在地圖選定 3 個以上頂點繪製多邊形區域，自動在範圍內隨機自然漫步，模擬最真實的戶外散步走動軌跡。
              </p>
            </div>

            <div class="feature-item">
              <div class="feature-item__icon-wrap">
                <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                  <path d="M19 21l-7-5-7 5V5a2 2 0 0 1 2-2h10a2 2 0 0 1 2 2z"></path>
                </svg>
              </div>
              <h3 class="feature-item__title">自訂書籤與純點庫</h3>
              <p class="feature-item__desc">
                支援建立景點資料夾、標籤分類與匯入匯出備份。官方更提供全台純點座標庫與每週主題巡航專欄。
              </p>
            </div>
          </div>

          <!-- Download Action Bar -->
          <div class="geosim-intro-actions">
            <a
              href={playStoreUrl}
              target="_blank"
              rel="noopener noreferrer"
              class="btn btn--primary btn--lg btn-playstore"
            >
              <svg width="20" height="20" viewBox="0 0 24 24" fill="currentColor">
                <path d="M3.609 1.814L13.792 12 3.61 22.186a.996.996 0 01-.61-.92V2.734a1 1 0 01.609-.92zm10.89 10.893l2.302 2.302-10.937 6.333 8.635-8.635zm3.199-3.199l2.302 1.329-2.822 1.634-2.116-2.116 2.636-2.847zm-4.529-4.528L4.864 1.367 15.8 7.7l-2.63 2.88z"/>
              </svg>
              前往 Google Play 免費下載 GeoSim
            </a>
            <a href="/geosim" class="btn btn--outline btn--lg">
              閱讀 GeoSim 完整功能介紹
            </a>
            <a href="/geosim/spot-map" class="btn btn--ghost btn--lg">
              探索全球純點座標庫
            </a>
          </div>
        </div>
      </div>
    </section>

    <!-- How to Use Section -->
    <section id="how-to-use" class="how-to-use-section">
      <div class="container">
        <div class="how-to-use-card">
          <h2 class="how-to-use__title">如何在手機上搭配 GeoSim 使用</h2>
          <div class="steps-grid">
            <div class="step-card">
              <div class="step-card__number">1</div>
              <h3 class="step-card__title">直開 GeoSim（自動導向商店）</h3>
              <p>
                在手機瀏覽器點擊門市卡片上的 <strong>「直開 GeoSim」</strong> 按鈕，系統將直接啟動 App 並定位在該門市。若尚未安裝，將自動前往 Google Play 商店下載。
              </p>
            </div>
            <div class="step-card">
              <div class="step-card__number">2</div>
              <h3 class="step-card__title">複製座標貼上</h3>
              <p>
                點擊卡片上的 <strong>「複製座標」</strong>，經緯度直接複製進剪貼簿。切換到 GeoSim 主畫面或懸浮控制器的搜尋欄即可貼上前往。
              </p>
            </div>
            <div class="step-card">
              <div class="step-card__number">3</div>
              <h3 class="step-card__title">整區巡航自動走 2,000 步</h3>
              <p>
                點擊各區頂部的 <strong>「複製巡航路徑」</strong>，可一次取得該縣市所有門市路徑。貼入 GeoSim 的「依線巡航」，自動掛機散步 2,000 步並依序抵達門市領花苗。
              </p>
            </div>
            <div class="step-card">
              <div class="step-card__number">4</div>
              <h3 class="step-card__title">7 天打卡記錄</h3>
              <p>
                每刷完一間門市，勾選 <strong>「標記已領取」</strong>，手機會自動記錄日期並鎖定 7 天倒數，下次可刷日期一清二楚。
              </p>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- Floating Copy Toast (Clean, no emoji) -->
    <div id="copy-toast" class="copy-toast" role="alert" aria-live="polite">
      已複製座標，可貼入 GeoSim
    </div>
  </main>
</BaseLayout>

<script is:inline>
  (function () {
    // 0. LINE / In-App Browser Breakout & Detection
    (function handleInAppBrowser() {
      const ua = navigator.userAgent || '';
      const isLine = /Line\//i.test(ua);
      const isFB = /FBAN|FBAV|Instagram/i.test(ua);
      const isAndroid = /Android/i.test(ua);
      const isIOS = /iPhone|iPad|iPod/i.test(ua);

      if (isLine || isFB) {
        if (isAndroid) {
          if (!window.location.search.includes('intent_redirected=1')) {
            const intentUri = 'intent://' + window.location.host + window.location.pathname + '#Intent;scheme=https;package=com.android.chrome;end;';
            window.location.href = intentUri;
          }
        } else if (isIOS) {
          const bar = document.getElementById('inapp-browser-bar');
          if (bar) bar.style.display = 'block';
        }
      }

      const closeBar = document.getElementById('btn-close-inapp-bar');
      if (closeBar) {
        closeBar.addEventListener('click', () => {
          const bar = document.getElementById('inapp-browser-bar');
          if (bar) bar.style.display = 'none';
        });
      }
    })();

    // 1. Constants & State
    const STORAGE_KEY_PREFIX = 'coco_store_visited_';
    const SEVEN_DAYS_MS = 7 * 24 * 60 * 60 * 1000;
    const PLAY_STORE_URL = 'https://play.google.com/store/apps/details?id=com.kairosvector.geosim';

    let currentCity = 'all';
    let currentStatus = 'all';
    let currentSearch = '';

    const toast = document.getElementById('copy-toast');
    let toastTimer = null;

    function showToast(msg) {
      if (!toast) return;
      toast.textContent = msg;
      toast.classList.add('show');
      clearTimeout(toastTimer);
      toastTimer = setTimeout(() => {
        toast.classList.remove('show');
      }, 2400);
    }

    // 2. Visited Status Handling (7-day cooldown in localStorage)
    function getVisitedTime(storeId) {
      try {
        const val = localStorage.getItem(STORAGE_KEY_PREFIX + storeId);
        return val ? parseInt(val, 10) : 0;
      } catch (e) {
        return 0;
      }
    }

    function setVisited(storeId, isVisited) {
      try {
        if (isVisited) {
          localStorage.setItem(STORAGE_KEY_PREFIX + storeId, Date.now().toString());
        } else {
          localStorage.removeItem(STORAGE_KEY_PREFIX + storeId);
        }
      } catch (e) {}
      updateAllStoreStates();
      filterStores();
    }

    function formatDate(ms) {
      const d = new Date(ms);
      return `${d.getMonth() + 1}/${d.getDate()} ${String(d.getHours()).padStart(2, '0')}:${String(d.getMinutes()).padStart(2, '0')}`;
    }

    function updateAllStoreStates() {
      const now = Date.now();
      let countTodo = 0;
      let countCooling = 0;
      let countReady = 0;

      document.querySelectorAll('.store-card').forEach((card) => {
        const storeId = card.getAttribute('data-store-id');
        const visitedTime = getVisitedTime(storeId);
        const checkbox = card.querySelector('.check-toggle__input');
        const banner = card.querySelector('.cooldown-banner');
        const dateSpan = card.querySelector('.next-available-date');

        if (!visitedTime) {
          // 尚未前往
          card.classList.remove('is-visited', 'is-cooling', 'is-ready');
          card.setAttribute('data-status-state', 'todo');
          if (checkbox) checkbox.checked = false;
          if (banner) banner.style.display = 'none';
          countTodo++;
        } else if (now - visitedTime < SEVEN_DAYS_MS) {
          // 7 天冷卻中
          card.classList.add('is-visited', 'is-cooling');
          card.classList.remove('is-ready');
          card.setAttribute('data-status-state', 'cooling');
          if (checkbox) checkbox.checked = true;
          if (banner) {
            banner.style.display = 'flex';
            banner.className = 'cooldown-banner muse-cooldown-badge is-cooling-badge';
            const nextDate = visitedTime + SEVEN_DAYS_MS;
            if (dateSpan) dateSpan.textContent = formatDate(nextDate);
          }
          countCooling++;
        } else {
          // 冷卻完畢（滿 7 天，可再次前往領花苗）
          card.classList.add('is-visited', 'is-ready');
          card.classList.remove('is-cooling');
          card.setAttribute('data-status-state', 'ready');
          if (checkbox) checkbox.checked = false;
          if (banner) {
            banner.style.display = 'flex';
            banner.className = 'cooldown-banner muse-cooldown-badge is-ready-badge';
            if (dateSpan) dateSpan.textContent = '滿 7 天可再次領取！';
          }
          countReady++;
        }
      });

      // Update Top Status Counter
      const pillDone = document.getElementById('pill-done-count');
      if (pillDone) pillDone.textContent = `${countCooling}`;

      // Update Status Pills Counters
      const elTodo = document.getElementById('count-todo');
      const elCooling = document.getElementById('count-cooling');
      const elReady = document.getElementById('count-ready');
      if (elTodo) elTodo.textContent = `${countTodo}`;
      if (elCooling) elCooling.textContent = `${countCooling}`;
      if (elReady) elReady.textContent = `${countReady}`;
    }

    // 3. Direct Launch to Pikmin Bloom (Wide Area Map with Coordinates & 100% Store Fallback)
    function openInPikmin(lat, lng) {
      const LAT = Number(lat).toFixed(7);
      const LNG = Number(lng).toFixed(7);
      const ua = navigator.userAgent || '';
      const isAndroid = /Android/i.test(ua);
      const isIOS = /iPhone|iPad|iPod/i.test(ua);
      const playStore = 'https://play.google.com/store/apps/details?id=com.nianticlabs.pikmin';
      const appStore = 'https://apps.apple.com/app/id1492797348';
      const fallbackUrl = isIOS ? appStore : playStore;

      showToast('正在開啟 Pikmin Bloom...');

      let appOpened = false;
      const fallbackTimer = setTimeout(() => {
        if (!appOpened && !document.hidden) {
          window.location.href = fallbackUrl;
        }
      }, 1800);

      const onVisibilityChange = () => {
        if (document.hidden) {
          appOpened = true;
          clearTimeout(fallbackTimer);
        }
      };
      window.addEventListener('visibilitychange', onVisibilityChange, { once: true });
      window.addEventListener('pagehide', onVisibilityChange, { once: true });

      if (isAndroid) {
        location.href = 'intent:///WIDE_AREA_MAP?LATITUDE=' + LAT + '&LONGITUDE=' + LNG
          + '#Intent;scheme=pikminbloom;package=com.nianticlabs.pikmin;S.browser_fallback_url=' + encodeURIComponent(playStore) + ';end';
        return;
      }
      location.href = 'pikminbloom:///WIDE_AREA_MAP?LATITUDE=' + LAT + '&LONGITUDE=' + LNG;
    }

    // 4. Direct 1-Click Launch to GeoSim
    async function launchGeoSim(lat, lng, storeName, coordsText) {
      if (window.AndroidGeoSim && typeof window.AndroidGeoSim.setCoordinate === 'function') {
        window.AndroidGeoSim.setCoordinate(parseFloat(lat), parseFloat(lng), storeName);
        showToast(`已帶入 GeoSim: ${storeName}`);
        return;
      }
      showToast(`正在開啟 GeoSim...`);
      const isAndroid = /Android/i.test(navigator.userAgent);
      const encodedName = encodeURIComponent(storeName);
      const fallbackUrlEncoded = encodeURIComponent(PLAY_STORE_URL);

      if (isAndroid) {
        const intentUri = `intent://location?lat=${lat}&lng=${lng}&label=${encodedName}#Intent;scheme=geosim;package=com.kairosvector.geosim;S.browser_fallback_url=${fallbackUrlEncoded};end`;
        let appOpened = false;
        const fallbackTimer = setTimeout(() => {
          if (!appOpened && !document.hidden) {
            window.location.href = PLAY_STORE_URL;
          }
        }, 1800);

        const onVisibilityChange = () => {
          if (document.hidden) {
            appOpened = true;
            clearTimeout(fallbackTimer);
          }
        };
        window.addEventListener('visibilitychange', onVisibilityChange, { once: true });
        window.addEventListener('pagehide', onVisibilityChange, { once: true });
        window.location.href = intentUri;
      } else {
        window.location.href = PLAY_STORE_URL;
      }
    }

    // 5. Copy Text Helper
    async function copyToClipboard(text, msg) {
      try {
        await navigator.clipboard.writeText(text);
      } catch (e) {
        const ta = document.createElement('textarea');
        ta.value = text;
        document.body.appendChild(ta);
        ta.select();
        document.execCommand('copy');
        document.body.removeChild(ta);
      }
      showToast(msg || '已複製至剪貼簿');
    }

    // 6. Multi-Dimensional Filtering Logic
    function filterStores() {
      const q = currentSearch.trim().toLowerCase();
      let visibleCount = 0;

      document.querySelectorAll('.store-card').forEach((card) => {
        const city = card.getAttribute('data-city');
        const name = (card.getAttribute('data-name') || '').toLowerCase();
        const shortName = (card.getAttribute('data-short') || '').toLowerCase();
        const coords = card.getAttribute('data-coords') || '';
        const state = card.getAttribute('data-status-state') || 'todo';

        // 1. City match
        const cityMatch = (currentCity === 'all' || city === currentCity);

        // 2. Status match (all / todo / cooling / ready)
        let statusMatch = true;
        if (currentStatus !== 'all') {
          statusMatch = (state === currentStatus);
        }

        // 3. Keyword search match
        let searchMatch = true;
        if (q) {
          searchMatch = name.includes(q) || shortName.includes(q) || coords.includes(q);
        }

        if (cityMatch && statusMatch && searchMatch) {
          card.style.display = '';
          visibleCount++;
        } else {
          card.style.display = 'none';
        }
      });

      // Show/Hide City Sections based on visible cards
      document.querySelectorAll('.city-section').forEach((sec) => {
        const secCity = sec.getAttribute('data-city-section');
        const anyVisible = sec.querySelectorAll('.store-card:not([style*="display: none"])').length > 0;
        if (currentCity !== 'all' && secCity !== currentCity) {
          sec.style.display = 'none';
        } else {
          sec.style.display = anyVisible ? '' : 'none';
        }
      });

      const statText = document.getElementById('stat-summary-text');
      if (statText) statText.textContent = `顯示 ${visibleCount} 家門市`;

      const noResults = document.getElementById('no-results-box');
      if (noResults) noResults.style.display = visibleCount === 0 ? 'block' : 'none';
    }

    // 7. Event Listeners Setup
    function setupEventListeners() {
      updateAllStoreStates();

      // Checkbox click: Toggle 7-Day Cooldown
      document.querySelectorAll('.check-toggle__input').forEach((cb) => {
        cb.addEventListener('change', (e) => {
          const storeId = e.target.getAttribute('data-store-id');
          setVisited(storeId, e.target.checked);
        });
      });

      // Button: Direct Launch Pikmin Bloom
      document.querySelectorAll('.btn-launch-pikmin').forEach((btn) => {
        btn.addEventListener('click', (e) => {
          e.preventDefault();
          const lat = parseFloat(btn.getAttribute('data-lat'));
          const lng = parseFloat(btn.getAttribute('data-lng'));
          const name = btn.getAttribute('data-name') || '';
          if (!isNaN(lat) && !isNaN(lng)) {
            showToast(`正在開啟遊戲 (${name})...`);
            openInPikmin(lat, lng);
          }
        });
      });

      // Button: Direct Launch GeoSim
      document.querySelectorAll('.btn-launch-geosim').forEach((btn) => {
        btn.addEventListener('click', (e) => {
          e.preventDefault();
          const lat = btn.getAttribute('data-lat');
          const lng = btn.getAttribute('data-lng');
          const name = btn.getAttribute('data-name');
          const coords = btn.getAttribute('data-coords');
          launchGeoSim(lat, lng, name, coords);
        });
      });

      // Button: Copy Single Coordinate
      document.querySelectorAll('.btn-copy-coord').forEach((btn) => {
        btn.addEventListener('click', (e) => {
          e.preventDefault();
          const coords = btn.getAttribute('data-coords');
          const name = btn.getAttribute('data-name');
          copyToClipboard(coords, `已複製 ${name} 座標`);
        });
      });

      // Button: Copy Region Route
      document.querySelectorAll('.btn-copy-region-route').forEach((btn) => {
        btn.addEventListener('click', (e) => {
          e.preventDefault();
          const route = btn.getAttribute('data-route');
          const city = btn.getAttribute('data-city');
          copyToClipboard(route, `已複製【${city}】巡航路徑，可貼入 GeoSim`);
        });
      });

      // Button: Copy All 331 Route in Hero & Tools Panel
      document.querySelectorAll('#btn-copy-all-route, .btn-copy-all-route').forEach((btn) => {
        btn.addEventListener('click', (e) => {
          e.preventDefault();
          const route = btn.getAttribute('data-route');
          copyToClipboard(route, `已複製全台 331 店巡航路徑，可貼入 GeoSim`);
        });
      });

      // Tier 1: City Pills Filter
      document.querySelectorAll('.city-pill').forEach((btn) => {
        btn.addEventListener('click', () => {
          document.querySelectorAll('.city-pill').forEach(b => {
            b.classList.remove('active');
            b.setAttribute('aria-selected', 'false');
          });
          btn.classList.add('active');
          btn.setAttribute('aria-selected', 'true');
          currentCity = btn.getAttribute('data-city');
          filterStores();
        });
      });

      // Tier 2: Status Pills Filter
      document.querySelectorAll('.status-pill').forEach((btn) => {
        btn.addEventListener('click', () => {
          document.querySelectorAll('.status-pill').forEach(b => b.classList.remove('active'));
          btn.classList.add('active');
          currentStatus = btn.getAttribute('data-status');
          filterStores();
        });
      });

      // Toggle Tools & Search Panel
      const btnToggle = document.getElementById('btn-toggle-tools');
      const toolsPanel = document.getElementById('muse-tools-panel');
      if (btnToggle && toolsPanel) {
        btnToggle.addEventListener('click', (e) => {
          e.preventDefault();
          const isOpen = toolsPanel.style.display !== 'none';
          toolsPanel.style.display = isOpen ? 'none' : 'block';
          btnToggle.classList.toggle('active', !isOpen);
          btnToggle.setAttribute('aria-expanded', !isOpen ? 'true' : 'false');
        });
      }

      // Keyword Search Input
      const searchInput = document.getElementById('store-search-input');
      const clearBtn = document.getElementById('clear-search-btn');
      if (searchInput) {
        searchInput.addEventListener('input', (e) => {
          currentSearch = e.target.value;
          if (clearBtn) clearBtn.style.display = currentSearch ? 'block' : 'none';
          filterStores();
        });
      }
      if (clearBtn && searchInput) {
        clearBtn.addEventListener('click', () => {
          searchInput.value = '';
          currentSearch = '';
          clearBtn.style.display = 'none';
          filterStores();
        });
      }

      // Reset Filters Fallback Button
      const resetBtn = document.getElementById('btn-reset-filters');
      if (resetBtn) {
        resetBtn.addEventListener('click', () => {
          currentCity = 'all';
          currentStatus = 'all';
          currentSearch = '';
          if (searchInput) searchInput.value = '';
          if (clearBtn) clearBtn.style.display = 'none';
          document.querySelectorAll('.city-pill').forEach(b => b.classList.remove('active'));
          document.querySelector('.city-pill[data-city="all"]')?.classList.add('active');
          document.querySelectorAll('.status-pill').forEach(b => b.classList.remove('active'));
          document.querySelector('.status-pill[data-status="all"]')?.classList.add('active');
          filterStores();
        });
      }
    }

    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', setupEventListeners);
    } else {
      setupEventListeners();
    }
  })();
</script>

