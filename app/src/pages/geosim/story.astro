    flex: none;
  }

  .story-ch p {
    margin: 0;
    font-size: 1.02rem;
    line-height: 1.85;
    color: var(--story-ink-soft);
  }

  /* Image Figures & Grids */
  .story-figures-grid {
    display: flex;
    justify-content: center;
    align-items: flex-start;
    gap: var(--space-6);
