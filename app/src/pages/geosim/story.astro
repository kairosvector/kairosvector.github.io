---
import BaseLayout from '../../layouts/BaseLayout.astro';
import products from '../../data/products.json';

const geosim = products.find(p => p.id === 'geosim')!;

const pageTitle = "GeoSim 的一天：手機真的相信自己在別的地方！| Kairos Vector Studio";
const pageDesc = "別的軟體說「已啟動」，結果根本沒動？GeoSim 證明給你看！白話帶你看懂如何讓手機一秒瞬間移動、像割草機一樣自動巡航、切到遊戲開啟懸浮小搖桿！";
---

<BaseLayout
  title={pageTitle}
  description={pageDesc}
  ogTitle="GeoSim 的一天 — 手機真的相信自己在別的地方！"
  ogDescription={pageDesc}
>
  <!-- Google Fonts for Editorial Narrative Feel -->
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin slot="head" />
  <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Noto+Serif+TC:wght@500;700&family=IBM+Plex+Mono:wght@400;500;600&display=swap" />

  <article class="story-wrapper">
    <!-- Breadcrumb & Nav Bar -->
    <div class="story-nav">
      <div class="story-nav__inner">
        <div class="story-breadcrumb">
          <a href="/">首頁</a>
          <span class="story-breadcrumb__sep">/</span>
          <a href="/geosim">GeoSim</a>
          <span class="story-breadcrumb__sep">/</span>
          <span class="story-breadcrumb__current">實戰手記（白話篇）</span>
        </div>
        <div class="story-nav__actions">
          <a href="/geosim" class="btn btn--outline btn--sm">
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <path d="M19 12H5M12 19l-7-7 7-7"/>
            </svg>
            返回 GeoSim 介紹
          </a>
          <a href={geosim.playStoreUrl} target="_blank" rel="noopener" class="btn btn--vibrant btn--sm">
            <svg width="14" height="14" viewBox="0 0 24 24" fill="currentColor">
              <path d="M3.609 1.814L13.792 12 3.61 22.186a.996.996 0 01-.61-.92V2.734a1 1 0 01.609-.92zm10.89 10.893l2.302 2.302-10.937 6.333 8.635-8.635zm3.199-3.199l2.302 1.329-2.822 1.634-2.116-2.116 2.636-2.847zm-4.529-4.528L4.864 1.367 15.8 7.7l-2.63 2.88z"/>
            </svg>
            Google Play 下載
          </a>
        </div>
      </div>
    </div>

    <!-- Main Container -->
    <div class="story-content">
      
      <!-- Hero Header -->
      <header class="story-hero">
        <div class="story-eyebrow">GEOSIM · 定位模擬測試實戰工具</div>
        <h1 class="story-title">GeoSim 的一天</h1>
        <p class="story-standfirst">
          早上九點，桌上放著一支手機。你在台北的辦公室，但等等要測試的那個門口，在十二公里外的台北 101。<br/>
          今天我們要幹的只有一件事：<em class="story-beat">給手機戴上一副「傳送門眼鏡」，讓它百分之百相信自己已經到了 101，而且你非常確定它真的信了。</em>
        </p>

        <!-- Route Simulation Plot (SVG) -->
        <figure class="story-plot">
          <svg viewBox="0 0 640 210" role="img" aria-label="一條由五個點組成的模擬路線，目前位置在第三點，外圈是定位精度半徑">
            <defs>
              <pattern id="story-grid-pattern" width="40" height="40" patternUnits="userSpaceOnUse">
                <path d="M40 0H0V40" fill="none" stroke="var(--story-grid)" stroke-width="1"/>
              </pattern>
            </defs>
            <rect width="640" height="210" fill="url(#story-grid-pattern)"/>

            <polyline points="58,158 172,112 296,132 420,66 574,92"
                      fill="none" stroke="var(--story-route)" stroke-width="2.5"
                      stroke-linecap="round" stroke-linejoin="round"/>

            <g fill="var(--story-panel)" stroke="var(--story-route)" stroke-width="2">
              <circle cx="58" cy="158" r="5.5"/>
              <circle cx="172" cy="112" r="5.5"/>
              <circle cx="420" cy="66" r="5.5"/>
              <circle cx="574" cy="92" r="5.5"/>
            </g>

            <circle class="story-ping" cx="296" cy="132" r="10" fill="none" stroke="var(--story-signal)" stroke-width="2"/>
            <circle cx="296" cy="132" r="19" fill="none" stroke="var(--story-signal)" stroke-width="1" stroke-dasharray="3 4" opacity=".5"/>
            <circle cx="296" cy="132" r="7" fill="var(--story-signal)"/>

            <g font-family="IBM Plex Mono, monospace" font-size="11" fill="var(--story-muted)">
              <text x="58" y="182" text-anchor="middle">1</text>
              <text x="172" y="136" text-anchor="middle">2</text>
              <text x="296" y="168" text-anchor="middle" fill="var(--story-signal)" font-weight="600">3 · 目前位置</text>
              <text x="420" y="50" text-anchor="middle">4</text>
              <text x="574" y="116" text-anchor="middle">5</text>
              <text x="330" y="128" fill="var(--story-signal)" font-weight="600">± 8 m 真實抖動</text>
            </g>
          </svg>
          <figcaption>五點折線 · 1.40 m/s 散步速度 · 循環關閉 · 精度 ±8 m · 每 0.5 秒推進守位</figcaption>
        </figure>
      </header>

      <!-- Chapter 00 -->
      <section class="story-ch">
        <div class="story-ch__head">
          <span class="story-ch__num">00</span>
          <h2 class="story-ch__title">序章：別的軟體說「成功」，結果根本沒動？</h2>
          <span class="story-ch__where">09:12 · 辦公室</span>
        </div>
        <p>
          你一定用過那種定位軟體：按鈕按下去，跳出一個「已啟動」，然後……就沒有然後了。  
          地圖完全沒動、通知也沒跳。你根本不知道是手機沒理它、是遊戲看穿了你在作弊、還是你自己設定錯了？
        </p>
        <p>
          <strong>GeoSim 的第一招，就是絕不讓你「猜」：</strong>  
          它把位置送到手機最深處的三道定位核心（連 Google 地圖都在看的那種），然後<em class="story-beat">馬上把手機實際接收到的座標抓回來當場對質</em>！
        </p>

        <!-- Live Status Pills Demo -->
        <div class="story-pill-group">
          <div class="story-pill">
            <span class="story-pill__dot"></span>
            <div class="story-pill__txt">
              <b>🟢 模擬中（正常運作）</b>
              <span class="story-pill__sub">已生效 · GPS・網路定位・Fused 三道防線全部打勾</span>
            </div>
          </div>
          <div class="story-pill story-pill--warn">
            <span class="story-pill__dot"></span>
            <div class="story-pill__txt">
              <b>🟡 位置好像卡住了？</b>
              <span class="story-pill__sub">系統已 42 秒沒理人 · GeoSim 正在自動搖醒它重新注入</span>
            </div>
          </div>
        </div>

        <p>
          這兩行小字就是最讓人安心的儀表板。綠燈時你可以放心去做別的事，亮黃燈時它自己會想辦法修好，
          你再也不用花一整個下午懷疑是不是自己手機壞掉了。
        </p>

        <div class="story-ledger">
          <div class="story-ledger__cap">這一幕最厲害的地方</div>
          <dl>
            <div class="story-ledger__row">
              <dt>模擬即時健檢</dt>
              <dd>手機深層的三大定位來源有沒有收到？成功的才打勾，絕不騙人<span class="story-tag">免費</span></dd>
            </div>
            <div class="story-ledger__row">
              <dt>座標讀回比對</dt>
              <dd>送出去 101，手機收到的真的是 101 嗎？逐筆核對才算數</dd>
            </div>
            <div class="story-ledger__row">
              <dt>睡著自動搖醒</dt>
              <dd>定位如果卡住不動，系統主動跳出提示並自動重新發送修復</dd>
            </div>
            <div class="story-ledger__row">
              <dt>背景不被殺</dt>
              <dd>開啟 Android 官方定位常駐服務，就算你跳去滑 IG、玩遊戲也不會被系統偷偷關掉</dd>
            </div>
          </dl>
        </div>
      </section>

      <!-- Chapter 01 -->
      <section class="story-ch">
        <div class="story-ch__head">
          <span class="story-ch__num">01</span>
          <h2 class="story-ch__title">瞬間移動：一秒把自己搬過去</h2>
          <span class="story-ch__where">09:40 · 台北 101</span>
        </div>
        <p>
          想把自己移到 101，你有三種最偷懶的方法，完全不用辛苦手抄那些幾十個數字的經緯度：
        </p>
        <p>
          1. <strong>在地圖上長按</strong>：手指按哪裡就飛到哪裡。<br/>
          2. <strong>搜尋地名</strong>：打「台北 101」，從清單挑選正確的那棟樓，不會亂飛。<br/>
          3. <strong>最神奇的「剪貼簿偷聽」</strong>：朋友在 LINE 傳給你一個 Google 地圖連結，你按了「複製」，一打開 GeoSim，畫面頂部直接貼心問你：<em class="story-beat">「你剛剛複製了這個點對吧？要不要秒飛過去？」</em>  
          點一下確認，你人就已經站在 101 大門口了！
        </p>

        <!-- Chapter 1 Screenshots -->
        <div class="story-figures-grid">
          <figure class="story-figure">
            <img src="/images/geosim/clipboard-prompt.jpg" alt="剪貼簿自動偵測彈窗" loading="lazy" class="story-figure__img" />
            <figcaption>📋 複製好地圖連結切回來，頂部自動跳出詢問框，點一下秒著陸！</figcaption>
          </figure>
          <figure class="story-figure">
            <img src="/images/geosim/single-point.jpg" alt="單點模擬選定畫面" loading="lazy" class="story-figure__img" />
            <figcaption>📍 選好地點後，下方會顯示距離並提供「換點」與「瞬間移動」</figcaption>
          </figure>
        </div>

        <div class="story-ledger">
          <div class="story-ledger__cap">這一幕最厲害的地方</div>
          <dl>
            <div class="story-ledger__row">
              <dt>剪貼簿自動辨識</dt>
              <dd>複製文字後自動認出經緯度，兩段式確認才移動，絕不手殘誤飛</dd>
            </div>
            <div class="story-ledger__row">
              <dt>地圖短網址解析</dt>
              <dd>朋友傳來的 maps.app.goo.gl 縮網址直接能解出位置，免手動轉換</dd>
            </div>
            <div class="story-ledger__row">
              <dt>天然 GPS 抖動</dt>
              <dd>可微調 ±3~8 公尺自然漂移，看起來像真人在戶外，完全不死板</dd>
            </div>
          </dl>
        </div>
      </section>

      <!-- Chapter 02 -->
      <section class="story-ch">
        <div class="story-ch__head">
          <span class="story-ch__num">02</span>
          <h2 class="story-ch__title">散步模式：從門外慢慢走進去</h2>
          <span class="story-ch__where">10:15 · 走路時速 5 km/h</span>
        </div>
        <p>
          光是瞬間移動站在門口還不夠，有時候 App 要偵測你「跨過大門」的那一瞬間。  
          這時候在地圖上用手指依序點五個點，一條路徑就畫好了！把速度拉到一般人走路的時速，按下開始。
        </p>
        <p>
          走到一半你覺得走太慢，<em class="story-beat">不必停下來重來</em>，手指拉一下速度條，下一步就自動加足馬力換節奏。<br/>
          走到店門口想停留 30 秒？你可以設定「原地定住」，也可以開啟「小碎步原地晃動」甚至「繞小圈打轉」——就像真人站在門口滑手機買飲料一樣逼真！
        </p>

        <!-- Chapter 2 Screenshots -->
        <div class="story-figures-grid">
          <figure class="story-figure">
            <img src="/images/geosim/route-berlin.jpg" alt="地圖折線巡航就緒" loading="lazy" class="story-figure__img" />
            <figcaption>🗺️ 地圖上依序標號的折線路徑，底下直接顯示距離與速度</figcaption>
          </figure>
          <figure class="story-figure">
            <img src="/images/geosim/route-settings.jpg" alt="各點停留與移動模式設定" loading="lazy" class="story-figure__img" />
            <figcaption>⚙️ 平滑 vs 跳點、不停留 / 原地停留 / 原地浮動 / 花式繞圈隨你選</figcaption>
          </figure>
        </div>

        <div class="story-ledger">
          <div class="story-ledger__cap">這一幕最厲害的地方</div>
          <dl>
            <div class="story-ledger__row">
              <dt>自訂多點折線</dt>
              <dd>地圖上隨便點就連成路徑，能隨時加點、刪點、改變順序</dd>
            </div>
            <div class="story-ledger__row">
              <dt>隨時變速</dt>
              <dd>移動中直接拉滑桿換速度（走路、慢跑、機車），免暫停重設</dd>
            </div>
            <div class="story-ledger__row">
              <dt>花式到點停留</dt>
              <dd>定住停留 / 原地小碎步浮動<span class="story-tag story-tag--pro">Pro</span> / 繞同心圓打轉<span class="story-tag story-tag--pro">Pro</span></dd>
            </div>
            <div class="story-ledger__row">
              <dt>來回無限折返</dt>
              <dd>走到底自動調頭往回走，或是從頭再跑一遍，跑一整天也不累</dd>
            </div>
          </dl>
        </div>
      </section>

      <!-- Chapter 03 -->
      <section class="story-ch">
        <div class="story-ch__head">
          <span class="story-ch__num">03</span>
          <h2 class="story-ch__title">整理收藏：好不容易畫好的路線，存進百寶箱！</h2>
          <span class="story-ch__where">11:30 · 收藏中心</span>
        </div>
        <p>
          這條路線明天還要測、下週還要跑，總不可能每次都要像傻子一樣重畫一遍吧？  
          存起來！給它取個名字叫「信義區巡邏」，丟進「我的路線」資料夾裡。<br/>
          地圖上存過的地點會變成漂亮的小圖標；存太多聚在一起時，還會自動打包成一顆「數字大泡泡」，放大地圖才會一顆顆散開。
        </p>

        <!-- Chapter 3 Screenshot -->
        <figure class="story-figure story-figure--single">
          <img src="/images/geosim/bookmarks.jpg" alt="書籤收藏資料夾清單" loading="lazy" class="story-figure__img" />
          <figcaption>📁 兩層資料夾分類，包括每周精選、皮克敏純點收集，井井有條！</figcaption>
        </figure>

        <div class="story-ledger">
          <div class="story-ledger__cap">這一幕最厲害的地方</div>
          <dl>
            <div class="story-ledger__row">
              <dt>兩層資料夾分類</dt>
              <dd>地點與整條路線都能存檔，資料夾底下還能再開資料夾</dd>
            </div>
            <div class="story-ledger__row">
              <dt>地圖自動打包</dt>
              <dd>太密的地點自動合體成泡泡數字，放大地圖才散開，畫面不眼花</dd>
            </div>
            <div class="story-ledger__row">
              <dt>GPX 匯入分享</dt>
              <dd>朋友傳來的 GPX 軌跡檔一鍵吃進去，過密點位自動智慧抽稀簡化<span class="story-tag story-tag--pro">Pro</span></dd>
            </div>
          </dl>
        </div>
      </section>

      <!-- Chapter 04 -->
      <section class="story-ch">
        <div class="story-ch__head">
          <span class="story-ch__num">04</span>
          <h2 class="story-ch__title">換邊玩：切到遊戲畫面，螢幕旁邊多了一顆透明小搖桿！</h2>
          <span class="story-ch__where">14:00 · 邊開遊戲邊控</span>
        </div>
        <p>
          真正要用的是別的遊戲或 App，不是 GeoSim 自己。所以你一定會切出畫面。  
          當你打開遊戲時，神奇的事情發生了：  
          螢幕角落飄著一顆<em class="story-beat">透明的虛擬小搖桿</em>！手指往哪推、人就往哪走，推一下還會有舒服的微震動回饋！
        </p>
        <p>
          如果你暫時不碰它，小搖桿會自己變淡、縮成右邊螢幕邊緣的一顆小圓點，完全不擋你看風景。
          桌面上還有專屬 Widget，連打開 App 都不用，看桌面就知道走到哪了！
        </p>

        <!-- Chapter 4 Screenshots -->
        <div class="story-figures-grid">
          <figure class="story-figure">
            <img src="/images/geosim/overlay-game-joystick.jpg" alt="在遊戲中懸浮的 360 度方向搖桿" loading="lazy" class="story-figure__img" />
            <figcaption>🎮 在皮克敏遊戲畫面上飄著 360° 方向搖桿與目前時速，推哪走哪！</figcaption>
          </figure>
          <figure class="story-figure">
            <img src="/images/geosim/overlay-collapsed.jpg" alt="放開手後搖桿自動收縮淡出" loading="lazy" class="story-figure__img" />
            <figcaption>✨ 閒置幾秒後自己縮成右側小圓點，視野清爽不擋路！</figcaption>
          </figure>
        </div>

        <div class="story-ledger">
          <div class="story-ledger__cap">這一幕最厲害的地方</div>
          <dl>
            <div class="story-ledger__row">
              <dt>360° 懸浮搖桿</dt>
              <dd>浮在任何遊戲或 App 之上，推動就走，帶有細緻震動回饋<span class="story-tag story-tag--pro">Pro</span></dd>
            </div>
            <div class="story-ledger__row">
              <dt>自動隱身收縮</dt>
              <dd>放手不碰自動半透明淡出，縮成邊緣小圖標，絕不擋螢幕<span class="story-tag story-tag--pro">Pro</span></dd>
            </div>
            <div class="story-ledger__row">
              <dt>桌面大圖標 Widget</dt>
              <dd>放在 Android 手機桌面，深淺兩色，看一眼就知道進度</dd>
            </div>
          </dl>
        </div>
      </section>

      <!-- Chapter 05 -->
      <section class="story-ch">
        <div class="story-ch__head">
          <span class="story-ch__num">05</span>
          <h2 class="story-ch__title">夜班：睡前叫它像割草機一樣自動巡航！</h2>
          <span class="story-ch__where">18:45 · 幾何大師上線</span>
        </div>
        <p>
          準備下班回家了，但你想讓手機整晚都在某個商圈裡繞來繞去自動測試。  
          自己手動畫一千個點會瘋掉，這時只要點開<em class="story-beat">「進階形狀」</em>：  
          選個中心點、拉一下半徑，叫它**「自動繞圓圈」**、**「像蚊香一樣往外螺旋」**，或是**「像割草機一樣把這區來回掃一遍」**！
        </p>
        <p>
          連星星、愛心、多邊形都能自動生成！設定好讓它循環整夜，**你回家睡覺，手機自己通宵勤奮逛街**。
        </p>

        <!-- Chapter 5 Screenshot -->
        <figure class="story-figure story-figure--single">
          <img src="/images/geosim/geometry-patterns.jpg" alt="進階形狀幾何自動巡航設定" loading="lazy" class="story-figure__img" />
          <figcaption>📐 圓繞圈、方繞方、螺旋、割草機掃描、星形愛心，拉一下半徑立刻開跑！</figcaption>
        </figure>

        <div class="story-ledger">
          <div class="story-ledger__cap">這一幕最厲害的地方</div>
          <dl>
            <div class="story-ledger__row">
              <dt>圓圈與漸開螺旋</dt>
              <dd>中心點設好，自動生成平滑正圓或向外擴散的巡邏路徑</dd>
            </div>
            <div class="story-ledger__row">
              <dt>割草機矩形掃描</dt>
