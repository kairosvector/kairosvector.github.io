  }

  .story-beat {
    font-style: normal;
    font-weight: 700;
    color: var(--story-ink);
    box-shadow: inset 0 -0.45em 0 var(--story-signal-soft);
    padding: 0 2px;
  }

  /* SVG Plot Component */
  .story-plot {
    background: var(--story-panel);
    border: 1px solid var(--story-rule);
    border-radius: var(--radius-md);
    box-shadow: var(--story-shadow);
    padding: 1rem 1rem 0.6rem;
    overflow-x: auto;
