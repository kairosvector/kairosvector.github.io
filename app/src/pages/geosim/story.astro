    letter-spacing: 0.04em;
    padding: 0.7rem 0.4rem 0.2rem;
    border-top: 1px solid var(--story-rule);
    margin-top: 0.6rem;
  }

  @keyframes pingAnim {
    0%   { r: 10; opacity: 0.65; }
    100% { r: 32; opacity: 0; }
  }

  .story-ping {
    animation: pingAnim 2.6s ease-out infinite;
  }

  @media (prefers-reduced-motion: reduce) {
    .story-ping {
      animation: none;
      opacity: 0.3;
    }
  }

  /* Chapter Section */
  .story-ch {
    display: flex;
    flex-direction: column;
    gap: var(--space-4);
  }

  .story-ch__head {
    display: flex;
