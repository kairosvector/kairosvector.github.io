<style>
  /* =======================================================
     Theme Color Mapping for Story Editorial Layout
     Supports Cyber Dark (default) & Electric Prism (vibrant)
     ======================================================= */
  :root,
  html[data-theme="dark"] {
    --story-ground: var(--color-bg);
    --story-panel: var(--color-surface);
    --story-panel-2: #161C2C;
    --story-ink: var(--color-text);
    --story-ink-soft: var(--color-text-secondary);
    --story-muted: var(--color-text-muted);
    --story-rule: var(--color-border);
    --story-grid: rgba(255, 255, 255, 0.05);
    
    --story-signal: #3FD6A0;
    --story-signal-soft: rgba(63, 214, 160, 0.16);
    --story-route: #38BDF8;
    --story-route-soft: rgba(56, 189, 248, 0.16);
    --story-warn: #F59E0B;
    --story-warn-soft: rgba(245, 158, 11, 0.14);
    
    --story-shadow: 0 4px 20px rgba(0, 0, 0, 0.35);
  }

  html[data-theme="vibrant"] {
    --story-ground: var(--color-bg);
    --story-panel: #FFFFFF;
    --story-panel-2: #F8FAFC;
    --story-ink: var(--color-text);
    --story-ink-soft: var(--color-text-secondary);
    --story-muted: var(--color-text-muted);
    --story-rule: var(--color-border);
    --story-grid: rgba(0, 0, 0, 0.05);
    
    --story-signal: #0B7E5E;
    --story-signal-soft: #D6EDE4;
    --story-route: #0284C7;
    --story-route-soft: #E0F2FE;
    --story-warn: #D97706;
    --story-warn-soft: #FEF3C7;
    
    --story-shadow: 0 4px 16px rgba(15, 23, 42, 0.06);
  }

  /* Typography Variables */
  .story-wrapper {
    --story-serif: "Noto Serif TC", Georgia, serif;
    --story-sans: var(--font-body);
    --story-mono: "IBM Plex Mono", var(--font-mono);
    --story-measure: 44rem;

    background-color: var(--story-ground);
    background-image:
      linear-gradient(var(--story-grid) 1px, transparent 1px),
      linear-gradient(90deg, var(--story-grid) 1px, transparent 1px);
    background-size: 56px 56px, 56px 56px;
    background-position: -1px -1px;
    min-height: 100vh;
    padding-top: var(--nav-height);
  }

  /* Breadcrumb & Sub-navigation */
  .story-nav {
    border-bottom: 1px solid var(--story-rule);
    background: rgba(var(--story-ground), 0.85);
    backdrop-filter: blur(12px);
    position: sticky;
    top: var(--nav-height);
    z-index: 40;
  }

  .story-nav__inner {
    max-width: 52rem;
    margin: 0 auto;
    padding: var(--space-3) var(--space-6);
    display: flex;
    justify-content: space-between;
    align-items: center;
    flex-wrap: wrap;
    gap: var(--space-3);
  }

  .story-breadcrumb {
    font-family: var(--story-mono);
    font-size: 0.8125rem;
    color: var(--story-muted);
    display: flex;
    align-items: center;
    gap: var(--space-2);
  }

  .story-breadcrumb a {
    color: var(--story-muted);
    transition: color var(--duration-fast);
  }

  .story-breadcrumb a:hover {
    color: var(--color-brand);
  }

  .story-breadcrumb__sep {
    opacity: 0.4;
  }

  .story-breadcrumb__current {
    color: var(--story-ink);
    font-weight: 500;
  }

  .story-nav__actions {
    display: flex;
    align-items: center;
    gap: var(--space-3);
  }

  /* Container */
  .story-content {
    max-width: 50rem;
    margin: 0 auto;
    padding: clamp(2rem, 5vw, 4rem) clamp(1.2rem, 4vw, 2.5rem) 6rem;
    display: flex;
    flex-direction: column;
    gap: clamp(3rem, 6vw, 4.5rem);
  }

  /* Hero Section */
  .story-hero {
    display: flex;
    flex-direction: column;
    gap: var(--space-4);
  }

  .story-eyebrow {
    font-family: var(--story-mono);
