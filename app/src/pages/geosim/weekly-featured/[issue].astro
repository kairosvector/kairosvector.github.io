---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import locationsData from '../../../data/locations.json';
import products from '../../../data/products.json';
import { readFileSync, existsSync } from 'node:fs';
import { join } from 'node:path';

// 各期實景圖出處（public 下的 _sources.json，建置期用 node:fs 讀，不進前端 bundle）。
// Vite 不允許從 public/ import，所以這裡走檔案系統。
// 新增一批圖時（如 castle/church/bridge）：照同格式放 _sources.json，這裡加一行進陣列。
function readSources(folder: string): any[] {
  try {
    const p = join(process.cwd(), 'public', 'images', 'postcards', folder, '_sources.json');
    if (!existsSync(p)) return [];
    const parsed = JSON.parse(readFileSync(p, 'utf-8'));
    return Array.isArray(parsed) ? parsed : [];
  } catch {
    return [];
  }
}

export async function getStaticPaths() {
  const paths = locationsData.weeklyFeatured.map((issue) => ({
    params: { issue: issue.id },
    props: { currentIssue: issue }
  }));
  // 固定最新一期永久別名：/geosim/weekly-featured/latest
  if (locationsData.weeklyFeatured.length > 0) {
    paths.push({
      params: { issue: 'latest' },
      props: { currentIssue: locationsData.weeklyFeatured[0] }
    });
  }
  return paths;
}

const { currentIssue } = Astro.props;
const product = products.find((p) => p.id === 'geosim')!;

// 出處聚合：key = 存檔路徑。沒有出處檔的期別自動隱藏整區，
// 所以舊期（Threads 截圖時代）不受影響。
const creditSources = [...readSources('shrine')];
const creditByPath = new Map(creditSources.map((s) => [s.saved, s]));
const creditEntries = (currentIssue.spots || [])
  .map((s) => {
    const c = s.image ? creditByPath.get(s.image) : null;
    return c ? { ...c, spotName: s.name } : null;
  })
  .filter((c) => c !== null)
  .filter((c, i, arr) => arr.findIndex((x) => x.saved === c.saved) === i);

// Generate all coordinates in line-by-line format for GeoSim batch import
const allCoordsString = currentIssue.spots
  ? currentIssue.spots.map((s) => `${s.lat},${s.lng}`).join('\n')
  : '';

// Default share drafts if missing
const lineDraft = currentIssue.lineShareDraft || `嗨皮友們！這期 GeoSim 整理了【${currentIssue.theme}】的精選座標，在家漫遊就能打菇寄給好友，完整座標看這裡 👉 https://kairosvector.com/geosim/weekly-featured/${currentIssue.id}`;
const threadsDraft = currentIssue.socialShareDraft || `【GeoSim 每周精選 ${currentIssue.issue} 🌟 ${currentIssue.theme}】\n\n本期完整座標看這裡 👉 https://kairosvector.com/geosim/weekly-featured/${currentIssue.id}\n#GeoSim #PikminBloom #皮克敏`;

---

<BaseLayout
  title={`${currentIssue.issue}：${currentIssue.theme} | 每周精選專欄 — GeoSim`}
  description={`GeoSim 官方每周精選探索地點：${currentIssue.theme}。包含精美明信片相片、景點微故事、精確經緯度座標與一鍵分享給好友文案。`}
  ogTitle={`${currentIssue.issue}：${currentIssue.theme}`}
  ogDescription={currentIssue.description}
>
  <div class="weekly-detail-page">
    <div class="hero__bg"></div>
    <div class="hero__grid-pattern"></div>

    <div class="container">
      <!-- Breadcrumbs -->
      <nav class="breadcrumb" aria-label="導覽路徑">
        <a href="/">首頁</a>
        <span class="breadcrumb__separator">/</span>
        <a href="/geosim">GeoSim</a>
        <span class="breadcrumb__separator">/</span>
        <a href="/geosim/weekly-featured">每周精選專欄</a>
        <span class="breadcrumb__separator">/</span>
        <span class="breadcrumb__current">{currentIssue.issue}</span>
      </nav>

      <!-- Page Header -->
      <header class="issue-header" data-animate>
        <div class="issue-header__badge-row">
          <a href="/geosim/weekly-featured" class="badge badge--geosim" style="text-decoration: none;">
            🌟 每周精選專欄
          </a>
          <span class="issue-header__number">{currentIssue.issue} • {currentIssue.date}</span>
          {currentIssue.region && (
            <span class="badge badge--outline">{currentIssue.region}</span>
          )}
          {currentIssue.categoryName && (
            <span class="badge badge--outline">{currentIssue.categoryName}</span>
          )}
        </div>
        <h1 class="issue-header__title">{currentIssue.theme}</h1>
        <p class="issue-header__lead">{currentIssue.description}</p>

        <!-- Quick Action Bar -->
        <div class="issue-quick-actions">
          <button
            id="copy-all-coords-btn"
            class="btn btn--primary btn--sm"
            data-coords={allCoordsString}
          >
            <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <path d="M16 4h2a2 2 0 0 1 2 2v14a2 2 0 0 1-2 2H6a2 2 0 0 1-2-2V6a2 2 0 0 1 2-2h2"></path>
              <rect x="8" y="2" width="8" height="4" rx="1" ry="1"></rect>
            </svg>
            一鍵複製本期全部座標 (GeoSim 格式)
          </button>
          <a href="#share-hub-section" class="btn btn--outline btn--sm">
            <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <path d="M4 12v8a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2v-8"></path>
              <polyline points="16 6 12 2 8 6"></polyline>
              <line x1="12" y1="2" x2="12" y2="15"></line>
            </svg>
            一鍵轉發給朋友 🎁
          </a>
          <a href="/geosim/weekly-featured" class="btn btn--outline btn--sm issue-header-back">
            ← 返回專欄總覽
          </a>
        </div>
      </header>

      {currentIssue.coverImage && (
        <div class="issue-cover-banner" data-animate>
          <img
            src={currentIssue.coverImage}
            alt={currentIssue.theme}
            class="issue-cover-banner__img"
            loading="eager"
          />
          <div class="issue-cover-banner__overlay">
            <span class="badge badge--geosim">📸 {currentIssue.issue} 精選專欄封面</span>
            <span class="issue-cover-banner__tagline">{currentIssue.theme}</span>
          </div>
        </div>
      )}

      <!-- Filter Toolbar & View Mode Switcher -->
      {currentIssue.spots && currentIssue.spots.length > 0 && (
        <div class="filter-toolbar" data-animate>
          <div class="filter-toolbar__group">
            <span class="filter-label">篩選類別：</span>
            <div class="filter-tabs">
              <button class="filter-tab active" data-filter="all">全部 ({currentIssue.spots.length})</button>
              <button class="filter-tab" data-filter="mushroom">🍄 蘑菇戰鬥點</button>
              <button class="filter-tab" data-filter="flower">🌸 巨型大花點</button>
              {currentIssue.spots.some(s => s.region === 'tw') && <button class="filter-tab" data-filter="tw">🇹🇼 台灣</button>}
              {currentIssue.spots.some(s => s.region === 'jp') && <button class="filter-tab" data-filter="jp">🇯🇵 日本</button>}
              {currentIssue.spots.some(s => s.region === 'global') && <button class="filter-tab" data-filter="global">🌍 國際其他</button>}
            </div>
          </div>
          <div class="view-mode-toggle" role="group" aria-label="版面檢視模式">
            <span class="filter-label">檢視模式：</span>
            <div class="view-toggle-pills">
              <button class="view-toggle-btn active" data-view="masonry" title="瀑布流探索模式 (手機雙欄超流暢)">
                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                  <rect x="3" y="3" width="7" height="11" rx="1"></rect>
                  <rect x="14" y="3" width="7" height="6" rx="1"></rect>
                  <rect x="14" y="13" width="7" height="8" rx="1"></rect>
                  <rect x="3" y="17" width="7" height="4" rx="1"></rect>
                </svg>
                <span>🧱 瀑布流</span>
              </button>
              <button class="view-toggle-btn" data-view="list" title="詳細列表模式">
                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                  <line x1="8" y1="6" x2="21" y2="6"></line>
                  <line x1="8" y1="12" x2="21" y2="12"></line>
                  <line x1="8" y1="18" x2="21" y2="18"></line>
                  <line x1="3" y1="6" x2="3.01" y2="6"></line>
                  <line x1="3" y1="12" x2="3.01" y2="12"></line>
                  <line x1="3" y1="18" x2="3.01" y2="18"></line>
                </svg>
                <span>詳細列表</span>
              </button>
            </div>
          </div>
        </div>
      )}

      <!-- Spots Grid (Default: RemixAI 雙欄瀑布流) -->
      <section class="weekly-spots-section" data-animate>
        <div class="spots-grid view-masonry" id="spots-grid-container">
          {currentIssue.spots && currentIssue.spots.map((spot, idx) => (
            <article
              class="card spot-postcard-card"
              data-region={spot.region || 'global'}
              data-type={spot.type || 'flower'}
              data-image={spot.image || ''}
              data-name={spot.name}
              data-seq={String(idx + 1).padStart(2, '0')}
              data-story={spot.story || spot.highlight || ''}
              data-coord={`${spot.lat}, ${spot.lng}`}
            >
              <!-- Postcard Photo Frame -->
              <div class="postcard-frame">
                {spot.image ? (
                  <img
                    src={spot.image}
                    alt={spot.name}
                    class="postcard-img"
                    loading={idx < 4 ? 'eager' : 'lazy'}
                  />
                ) : (
                  <div class="postcard-img-placeholder">
                    <span style="font-size: 32px; margin-bottom: 8px;">{spot.type === 'mushroom' ? '🍄' : '🌸'}</span>
                    <span>{spot.name}</span>
                  </div>
                )}
                <div class="postcard-badges-overlay">
                  {spot.type === 'mushroom' ? (
                    <span class="type-badge type-badge--mushroom" title="🍄 蘑菇戰鬥點">
                      <span class="badge-icon">🍄</span>
                      <span class="badge-text"> 蘑菇戰鬥點</span>
                    </span>
                  ) : (
                    <span class="type-badge type-badge--flower" title="🌸 巨型大花點">
                      <span class="badge-icon">🌸</span>
                      <span class="badge-text"> 巨型大花點</span>
                    </span>
                  )}
                  {spot.region === 'tw' && <span class="region-badge">🇹🇼 台灣</span>}
                  {spot.region === 'jp' && <span class="region-badge">🇯🇵 日本</span>}
                </div>
              </div>

              <!-- Postcard Details -->
              <div class="spot-card-body">
                <div class="spot-card-header">
                  <div class="spot-card-num-title">
                    <span class="spot-seq-num">#{String(idx + 1).padStart(2, '0')}</span>
                    <h3 class="spot-card-title">{spot.name}</h3>
                  </div>
                  {spot.tag && <span class="spot-tag-pill">{spot.tag}</span>}
                </div>

                <!-- Story / Commentary -->
                {(spot.story || spot.highlight) && (
                  <div class="spot-card-story">
                    <div class="story-icon">🌿</div>
                    <p class="story-text">{spot.story || spot.highlight}</p>
                  </div>
                )}

                <!-- Meta Bar -->
                <div class="spot-card-meta-bar">
                  <div class="meta-coord-block">
                    <span class="meta-label">座標：</span>
                    <code class="meta-coord-code">{spot.lat}, {spot.lng}</code>
                  </div>
                </div>

                <!-- Actions -->
                <div class="spot-card-footer">
                  <button
                    class="btn btn--geosim-glow btn--sm copy-single-coord-btn"
                    data-coord={`${spot.lat}, ${spot.lng}`}
                    title="複製經緯度到剪貼簿"
                    type="button"
                  >
                    <svg class="coord-icon-svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                      <path d="M12 2v4m0 12v4M2 12h4m12 0h4"></path>
                      <circle cx="12" cy="12" r="7"></circle>
                      <circle cx="12" cy="12" r="2"></circle>
                    </svg>
                    <span class="copy-btn-text">複製座標</span>
                  </button>
                  <a
                    href={`https://www.google.com/maps/search/?api=1&query=${spot.lat},${spot.lng}`}
                    target="_blank"
                    rel="noopener"
                    class="btn btn--outline btn--sm map-link-btn"
                    title="在 Google 地圖開啟"
                  >
                    <svg class="map-icon-svg" width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                      <path d="M12 2a8 8 0 0 0-8 8c0 5.25 8 12 8 12s8-6.75 8-12a8 8 0 0 0-8-8z"></path>
                      <circle cx="12" cy="10" r="3"></circle>
                    </svg>
                    <span class="map-link-text-full">Google 地圖 ↗</span>
                    <span class="map-link-text-short">地圖 ↗</span>
                  </a>
                </div>
              </div>
            </article>
          ))}
        </div>
      </section>

      <!-- Upgraded Social Share Hub (全民轉發與社群推薦神器) -->
      <section id="share-hub-section" class="social-share-hub" data-animate>
        <div class="card social-share-card">
          <div class="social-share-card__header">
            <div class="social-share-card__title-group">
              <span class="badge badge--geosim">🎁 全民社群推薦神器</span>
              <h2 class="social-share-card__title">覺得這期很讚？一鍵分享給朋友群！</h2>
              <p class="social-share-card__desc">
                免自己打字排版！我們為你準備好了「LINE 群聊親切版」與「Threads 深度推薦版」，點擊按鈕即可直接喚醒 App 或一鍵複製！
              </p>
            </div>

            <!-- Tab Buttons for Line vs Threads -->
            <div class="share-mode-toggle">
              <button id="tab-line-mode" class="share-mode-btn active">
                💬 LINE 聊天群推薦版
              </button>
              <button id="tab-threads-mode" class="share-mode-btn">
                🧵 Threads / 社群貼文版
              </button>
            </div>
          </div>

          <!-- LINE Box Content -->
          <div id="line-content-panel" class="share-panel">
            <div class="draft-preview-box">
              <div class="draft-preview-header">
                <span class="draft-preview-tag">💬 適合發至 LINE 皮克敏群組、好友私訊</span>
                <span class="draft-char-count">口氣親切 • 包含專屬連結</span>
              </div>
              <pre class="draft-text" id="line-draft-text">{lineDraft}</pre>
            </div>

            <div class="share-panel-actions">
              <button class="btn btn--primary btn--md" id="copy-line-btn" data-text={lineDraft}>
                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                  <rect x="9" y="9" width="13" height="13" rx="2" ry="2"></rect>
                  <path d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1"></path>
                </svg>
                複製 LINE 文案
              </button>
              <a
                href={`https://line.me/R/msg/text/?${encodeURIComponent(lineDraft)}`}
                target="_blank"
                rel="noopener"
                class="btn btn--outline btn--md btn--line-action"
              >
                📲 直接喚醒 LINE 傳送 ↗
              </a>
            </div>
          </div>

          <!-- Threads Box Content -->
          <div id="threads-content-panel" class="share-panel" style="display: none;">
            <div class="draft-preview-box">
              <div class="draft-preview-header">
                <span class="draft-preview-tag">🧵 適合發至 Threads、IG、FB 社團</span>
                <span class="draft-char-count">條列重點 • 自帶熱門 Hashtag</span>
              </div>
              <pre class="draft-text" id="threads-draft-text">{threadsDraft}</pre>
            </div>

            <div class="share-panel-actions">
              <button class="btn btn--primary btn--md" id="copy-threads-btn" data-text={threadsDraft}>
                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                  <rect x="9" y="9" width="13" height="13" rx="2" ry="2"></rect>
                  <path d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1"></path>
                </svg>
                複製 Threads 文案
              </button>
              <a
                href={`https://threads.net/intent/post?text=${encodeURIComponent(threadsDraft)}`}
                target="_blank"
                rel="noopener"
                class="btn btn--outline btn--md btn--threads-action"
              >
                🧵 打開發布到 Threads ↗
              </a>
              {currentIssue.threadsUrl && (
                <a
                  href={currentIssue.threadsUrl}
                  target="_blank"
                  rel="noopener"
                  class="btn btn--outline btn--md btn--threads-action"
                >
                  查看原串討論 ↗
                </a>
              )}
            </div>
          </div>
        </div>
      </section>

      <!-- Bottom Navigation Links -->
      <section class="weekly-bottom-nav" data-animate>
        <div class="card weekly-promo-card">
          <div class="weekly-promo-card__content">
            <h3>想查看更多往期特輯？</h3>
            <p>返回每周精選專欄總覽，隨時回顧全球各大城市、文化景觀與自然海濱專題路線。</p>
          </div>
          <div style="display: flex; gap: var(--space-3); flex-wrap: wrap;">
            <a href="/geosim/weekly-featured" class="btn btn--primary btn--lg">
              ← 返回專欄總覽列表
            </a>
            <a href="/geosim/spot-map" class="btn btn--outline btn--lg">
              前往純點地圖庫 🗺️
            </a>
          </div>
        </div>
      </section>

      {/* 圖片出處（CC 授權要求署名）。沒有出處資料的期別不顯示，
          所以 Threads 截圖時代的舊期不受影響。 */}
      {creditEntries.length > 0 && (
        <section class="photo-credits" data-animate>
          <details>
            <summary>📷 本期實景圖來源（{creditEntries.length}）</summary>
            <ul>
              {creditEntries.map((c) => (
                <li>
                  <span class="photo-credits__work">{c.spotName}</span>
                  <span class="photo-credits__by"> — {c.artist} · </span>
                  <a href={c.license_url} target="_blank" rel="noopener">
                    {c.license}
                  </a>
                </li>
              ))}
            </ul>
          </details>
        </section>
      )}

      <!-- Back Link -->
      <div class="back-to-geosim-wrap" style="text-align: center; margin-top: var(--space-10);">
        <a href="/geosim" class="btn btn--outline">
          ← 返回 GeoSim 產品專頁
        </a>
      </div>
    </div>
  </div>

  <!-- Postcard Lightbox Modal (景點相片放大預覽與微故事) -->
  <div id="postcard-lightbox" class="postcard-lightbox" role="dialog" aria-modal="true" aria-hidden="true">
    <div class="lightbox-overlay" id="lightbox-backdrop"></div>
    <div class="lightbox-dialog">
      <button class="lightbox-close-btn" id="lightbox-close-btn" aria-label="關閉預覽">✕</button>
      <div class="lightbox-media">
        <img id="lightbox-img" src="" alt="" />
      </div>
      <div class="lightbox-info">
        <div class="lightbox-header">
          <div class="lightbox-title-wrap">
            <span id="lightbox-seq" class="lightbox-seq">#01</span>
            <h3 id="lightbox-title" class="lightbox-title">景點名稱</h3>
          </div>
          <span id="lightbox-badge" class="type-badge type-badge--mushroom">🍄 蘑菇戰鬥點</span>
        </div>
        <p id="lightbox-story" class="lightbox-story"></p>
        <div class="lightbox-meta">
          <span class="meta-label">座標：</span>
          <code id="lightbox-coord" class="meta-coord-code">0.0, 0.0</code>
        </div>
        <div class="lightbox-actions">
          <button id="lightbox-copy-btn" class="btn btn--primary btn--sm" type="button">
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <path d="M12 2v4m0 12v4M2 12h4m12 0h4"></path>
              <circle cx="12" cy="12" r="7"></circle>
              <circle cx="12" cy="12" r="2"></circle>
            </svg>
            一鍵複製座標
          </button>
          <a id="lightbox-map-link" href="#" target="_blank" rel="noopener" class="btn btn--outline btn--sm">
            Google 地圖 ↗
          </a>
        </div>
      </div>
    </div>
  </div>

  <!-- Universal Toast Notification -->
  <div id="copy-toast" class="copy-toast" role="alert" aria-live="polite">
    <span id="toast-icon">✅</span>
    <span id="toast-message">座標已成功複製到剪貼簿！</span>
  </div>
</BaseLayout>

<script is:inline>
  function showToast(message, icon = '✅') {
    const toast = document.getElementById('copy-toast');
    const msgEl = document.getElementById('toast-message');
    const iconEl = document.getElementById('toast-icon');
    if (toast && msgEl) {
      msgEl.textContent = message;
      if (iconEl) iconEl.textContent = icon;
      toast.classList.add('show');
      setTimeout(() => {
        toast.classList.remove('show');
      }, 2800);
    }
  }

  // 1. Single coordinate copy
  document.querySelectorAll('.copy-single-coord-btn').forEach((btn) => {
    btn.addEventListener('click', async () => {
      const coord = btn.getAttribute('data-coord');
      const spotCard = btn.closest('.spot-postcard-card');
      const spotName = spotCard ? (spotCard.querySelector('.spot-card-title')?.textContent || '').trim() : '';
      if (coord) {
        // Android JS Bridge: directly transmit coordinate to GeoSim app
        if (window.AndroidGeoSim && typeof window.AndroidGeoSim.setCoordinate === 'function') {
          try {
            const parts = coord.split(',');
            const lat = parseFloat(parts[0].trim());
            const lng = parseFloat(parts[1].trim());
            window.AndroidGeoSim.setCoordinate(lat, lng, spotName);
            showToast(`已傳送座標至 GeoSim 搖桿：${coord}`, '🎮');
            return;
          } catch (e) {
            console.error('AndroidGeoSim bridge error:', e);
          }
        }
        try {
          await navigator.clipboard.writeText(coord);
          showToast(`已複製座標：${coord}，可直接貼入 GeoSim！`, '📍');
        } catch (err) {
          console.error(err);
        }
      }
    });
  });

  // 2. Batch all coordinates copy
  const copyAllBtn = document.getElementById('copy-all-coords-btn');
  if (copyAllBtn) {
    copyAllBtn.addEventListener('click', async () => {
      const coords = copyAllBtn.getAttribute('data-coords');
      if (coords) {
        if (window.AndroidGeoSim && typeof window.AndroidGeoSim.setRoute === 'function') {
          try {
            window.AndroidGeoSim.setRoute(coords);
            showToast('已傳送整期路線至 GeoSim 搖桿！', '🚀');
            return;
          } catch (e) {
            console.error('AndroidGeoSim route bridge error:', e);
          }
        }
        try {
          await navigator.clipboard.writeText(coords);
          showToast('已複製本期全部座標！可直接貼入 GeoSim 巡航路線', '🚀');
        } catch (err) {
          console.error(err);
        }
      }
    });
  }

  // 3. Social share toggle (LINE vs Threads)
  const tabLine = document.getElementById('tab-line-mode');
  const tabThreads = document.getElementById('tab-threads-mode');
  const panelLine = document.getElementById('line-content-panel');
  const panelThreads = document.getElementById('threads-content-panel');

  if (tabLine && tabThreads && panelLine && panelThreads) {
    tabLine.addEventListener('click', () => {
      tabLine.classList.add('active');
      tabThreads.classList.remove('active');
      panelLine.style.display = 'block';
      panelThreads.style.display = 'none';
    });

    tabThreads.addEventListener('click', () => {
      tabThreads.classList.add('active');
      tabLine.classList.remove('active');
      panelThreads.style.display = 'block';
      panelLine.style.display = 'none';
    });
  }

  // 4. Copy LINE draft
  const copyLineBtn = document.getElementById('copy-line-btn');
  if (copyLineBtn) {
    copyLineBtn.addEventListener('click', async () => {
      const text = copyLineBtn.getAttribute('data-text');
      if (text) {
        try {
          await navigator.clipboard.writeText(text);
          showToast('💬 LINE 文案已複製！直接貼到群組聊天室即可分享！', '📲');
        } catch (err) {
          console.error(err);
        }
      }
    });
  }

  // 5. Copy Threads draft
  const copyThreadsBtn = document.getElementById('copy-threads-btn');
  if (copyThreadsBtn) {
    copyThreadsBtn.addEventListener('click', async () => {
      const text = copyThreadsBtn.getAttribute('data-text');
      if (text) {
        try {
          await navigator.clipboard.writeText(text);
          showToast('🧵 Threads 文案已複製！直接貼上即可發布！', '📢');
        } catch (err) {
          console.error(err);
        }
      }
    });
  }

  // 6. Region & type filter tabs
  const filterTabs = document.querySelectorAll('.filter-tab');
  const cards = document.querySelectorAll('.spot-postcard-card');

  filterTabs.forEach((tab) => {
    tab.addEventListener('click', () => {
      filterTabs.forEach((t) => t.classList.remove('active'));
      tab.classList.add('active');

      const filterVal = tab.getAttribute('data-filter');
      cards.forEach((card) => {
        const region = card.getAttribute('data-region');
        const type = card.getAttribute('data-type');
        if (filterVal === 'all' || region === filterVal || type === filterVal) {
          card.style.display = '';
        } else {
          card.style.display = 'none';
        }
      });
    });
  });

  // 7. View Mode Switcher (Detailed List vs RemixAI 雙欄交錯瀑布流)
  const viewToggleBtns = document.querySelectorAll('.view-toggle-btn');
  const spotsGrid = document.getElementById('spots-grid-container');

  function updateWaterfallColumns(mode) {
    if (!spotsGrid) return;

    if (mode === 'list') {
      const cols = spotsGrid.querySelectorAll('.waterfall-col');
      if (cols.length > 0) {
        const allCards = Array.from(spotsGrid.querySelectorAll('.spot-postcard-card'));
        allCards.sort((a, b) => {
          const seqA = parseInt(a.getAttribute('data-seq') || '0', 10);
          const seqB = parseInt(b.getAttribute('data-seq') || '0', 10);
          return seqA - seqB;
        });
        cols.forEach((c) => c.remove());
        allCards.forEach((c) => spotsGrid.appendChild(c));
      }
      return;
    }

    // mode === 'masonry'
    const isMobile = window.innerWidth < 768;
    const colCount = isMobile ? 2 : 3;
    const existingCols = spotsGrid.querySelectorAll('.waterfall-col');
    if (existingCols.length === colCount) return;

    const allCards = Array.from(spotsGrid.querySelectorAll('.spot-postcard-card'));
    allCards.sort((a, b) => {
      const seqA = parseInt(a.getAttribute('data-seq') || '0', 10);
      const seqB = parseInt(b.getAttribute('data-seq') || '0', 10);
      return seqA - seqB;
    });

    existingCols.forEach((c) => c.remove());

    const cols = [];
    for (let i = 0; i < colCount; i++) {
      const col = document.createElement('div');
      col.className = `waterfall-col waterfall-col-${i + 1}`;
      cols.push(col);
    }

    allCards.forEach((card, idx) => {
      cols[idx % colCount].appendChild(card);
    });

    cols.forEach((col) => spotsGrid.appendChild(col));
  }

  function applyViewMode(mode) {
    viewToggleBtns.forEach((btn) => {
      btn.classList.toggle('active', btn.getAttribute('data-view') === mode);
    });
    if (spotsGrid) {
      if (mode === 'masonry') {
        spotsGrid.classList.add('view-masonry');
        updateWaterfallColumns('masonry');
      } else {
        spotsGrid.classList.remove('view-masonry');
        updateWaterfallColumns('list');
      }
    }
    try {
      localStorage.setItem('geosim_weekly_view_mode', mode);
    } catch (e) {}
  }

  viewToggleBtns.forEach((btn) => {
    btn.addEventListener('click', () => {
      const mode = btn.getAttribute('data-view');
      applyViewMode(mode);
    });
  });

  let resizeTimer;
  window.addEventListener('resize', () => {
    clearTimeout(resizeTimer);
    resizeTimer = setTimeout(() => {
      if (spotsGrid && spotsGrid.classList.contains('view-masonry')) {
        updateWaterfallColumns('masonry');
      }
    }, 150);
  });

  // Detect URL parameter (?view=list) or stored preference (預設即為瀑布流)
  const currentUrl = new URL(window.location.href);
  const viewParam = currentUrl.searchParams.get('view');
  let chosenView = 'masonry';
  if (viewParam === 'list') {
    chosenView = 'list';
  } else if (!viewParam) {
    try {
      const saved = localStorage.getItem('geosim_weekly_view_mode');
      if (saved === 'list') chosenView = 'list';
    } catch (e) {}
  }
  applyViewMode(chosenView);

  // 8. Postcard Lightbox Modal (Zoom Photo & View Story)
  const lightbox = document.getElementById('postcard-lightbox');
  const lightboxBackdrop = document.getElementById('lightbox-backdrop');
  const lightboxCloseBtn = document.getElementById('lightbox-close-btn');
  const lightboxImg = document.getElementById('lightbox-img');
  const lightboxSeq = document.getElementById('lightbox-seq');
  const lightboxTitle = document.getElementById('lightbox-title');
  const lightboxBadge = document.getElementById('lightbox-badge');
  const lightboxStory = document.getElementById('lightbox-story');
  const lightboxCoord = document.getElementById('lightbox-coord');
  const lightboxCopyBtn = document.getElementById('lightbox-copy-btn');
  const lightboxMapLink = document.getElementById('lightbox-map-link');

  let currentModalCoord = '';

  function openLightbox(card) {
    if (!lightbox) return;
    const img = card.getAttribute('data-image');
    const name = card.getAttribute('data-name') || '';
    const seq = card.getAttribute('data-seq') || '01';
    const story = card.getAttribute('data-story') || '';
    const coord = card.getAttribute('data-coord') || '';
    const type = card.getAttribute('data-type') || 'flower';

    currentModalCoord = coord;

    if (lightboxImg) {
      lightboxImg.src = img;
      lightboxImg.alt = name;
    }
    if (lightboxSeq) lightboxSeq.textContent = `#${seq}`;
    if (lightboxTitle) lightboxTitle.textContent = name;
    if (lightboxStory) lightboxStory.textContent = story || '暫無額外景點介紹。';
    if (lightboxCoord) lightboxCoord.textContent = coord;

    if (lightboxBadge) {
      if (type === 'mushroom') {
        lightboxBadge.className = 'type-badge type-badge--mushroom';
        lightboxBadge.textContent = '🍄 蘑菇戰鬥點';
      } else {
        lightboxBadge.className = 'type-badge type-badge--flower';
        lightboxBadge.textContent = '🌸 巨型大花點';
      }
    }

    if (lightboxMapLink) {
      lightboxMapLink.href = `https://www.google.com/maps/search/?api=1&query=${coord}`;
    }

    lightbox.classList.add('active');
    document.body.style.overflow = 'hidden';
  }

  function closeLightbox() {
    if (!lightbox) return;
    lightbox.classList.remove('active');
    document.body.style.overflow = '';
  }

  if (lightboxCloseBtn) lightboxCloseBtn.addEventListener('click', closeLightbox);
  if (lightboxBackdrop) lightboxBackdrop.addEventListener('click', closeLightbox);
  window.addEventListener('keydown', (e) => {
    if (e.key === 'Escape' && lightbox && lightbox.classList.contains('active')) {
      closeLightbox();
    }
  });

  if (lightboxCopyBtn) {
    lightboxCopyBtn.addEventListener('click', async () => {
      if (currentModalCoord) {
        if (window.AndroidGeoSim && typeof window.AndroidGeoSim.setCoordinate === 'function') {
          try {
            const parts = currentModalCoord.split(',');
            const lat = parseFloat(parts[0].trim());
            const lng = parseFloat(parts[1].trim());
            const name = lightboxTitle ? lightboxTitle.textContent : '';
            window.AndroidGeoSim.setCoordinate(lat, lng, name);
            showToast(`已傳送座標至 GeoSim 搖桿：${currentModalCoord}`, '🎮');
            return;
          } catch (e) {
            console.error('AndroidGeoSim bridge error:', e);
          }
        }
        try {
          await navigator.clipboard.writeText(currentModalCoord);
          showToast(`已複製座標：${currentModalCoord}，可直接貼入 GeoSim！`, '📍');
        } catch (err) {
          console.error(err);
        }
      }
    });
  }

  // Open Lightbox when clicking anywhere on the postcard card (except footer action buttons)
  cards.forEach((card) => {
    card.addEventListener('click', (e) => {
      if (e.target.closest('button') || e.target.closest('a')) {
        return;
      }
      openLightbox(card);
    });
  });
</script>

